-- [ VIGIA GLOBAL DE DETECÇÃO DO OWNER ]
-- ==========================================
task.spawn(function()
    while task.wait(2) do
        -- 1. Verifica se outros jogadores no servidor são o Owner (via Supabase Presence)
        if _G.PresenceTags then
            for uid, tag in pairs(_G.PresenceTags) do
                if tag == "Owner" or tag == "Creator" then
                    local plr = game:GetService("Players"):GetPlayerByUserId(uid)
                    if plr then
                        _G.PlayOwnerCinematic(plr)
                    end
                end
            end
        end
        
        -- 2. Verifica se VOCÊ é o Owner e reproduz sua própria entrada épica
        local myTag = _G.EquippedTag
        if not myTag then
            pcall(function() myTag = GetFirebaseRank(game.Players.LocalPlayer) end)
        end
        
        if myTag == "Owner" or myTag == "Creator" then
            _G.PlayOwnerCinematic(game.Players.LocalPlayer)
        end
    end
end)
