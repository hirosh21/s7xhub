    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        if p ~= game.Players.LocalPlayer and p.Character then
            -- Ignora pessoas do seu próprio time
            if p.Team == game.Players.LocalPlayer.Team and p.Team ~= nil then continue end
            
            local targetPart = p.Character:FindFirstChild(_G.S7xAimbot.TargetPart) or p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            
            if targetPart and hum and hum.Health > 0 then
                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                
                if onScreen then
                    local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist2D < minDist then
                        -- Wall Check Profissional (Verifica se não tem parede na frente)
                        local direction = (targetPart.Position - camera.CFrame.Position)
                        local rayResult = workspace:Raycast(camera.CFrame.Position, direction.Unit * direction.Magnitude, rayParams)
                        
                        if not rayResult or rayResult.Instance:IsDescendantOf(p.Character) then
                            minDist = dist2D
                            nearest = p
                        end
                    end
                end
            end
        end
    end

    _G.S7xAimbot.CurrentTarget = nearest

    -- Se achou um alvo válido
    if nearest and nearest.Character then
        local tPart = nearest.Character:FindFirstChild(_G.S7xAimbot.TargetPart) or nearest.Character:FindFirstChild("HumanoidRootPart")
        if tPart then
            
            -- 1. Atualiza Texto de Trava
            if _G.S7xAimbot.Text then
                _G.S7xAimbot.Text.Text = "[ LOCKED: " .. string.upper(nearest.DisplayName) .. " ]"
                _G.S7xAimbot.Text.Position = Vector2.new(mousePos.X, mousePos.Y + _G.S7xAimbot.FOV + 10)
                _G.S7xAimbot.Text.Visible = true
            end

            -- 2. APLICA O X-RAY (VISÃO ATRAVÉS DA PAREDE)
            if not nearest.Character:FindFirstChild("S7xTargetXRay") then
                _G.S7xClearAimbotESP() -- Limpa o alvo antigo
                
                local hl = Instance.new("Highlight")
                hl.Name = "S7xTargetXRay"
                hl.Adornee = nearest.Character
                hl.FillColor = Color3.fromRGB(255, 20, 60) -- Vermelho sangue
                hl.OutlineColor = Color3.fromRGB(255, 255, 255) -- Borda branca
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0.1
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- ISSO FAZ APARECER ATRÁS DA PAREDE
                hl.Parent = nearest.Character
                _G.S7xAimbot.Highlight = hl
            end

            -- 3. STICKY AIM (Gruda a câmera no inimigo de forma agressiva)
            local targetCFrame = CFrame.lookAt(camera.CFrame.Position, tPart.Position)
            camera.CFrame = camera.CFrame:Lerp(targetCFrame, _G.S7xAimbot.Smoothness)
        end
    else
        -- Se perder o alvo, desliga textos e remove o X-Ray
        if _G.S7xAimbot.Text then _G.S7xAimbot.Text.Visible = false end
        _G.S7xClearAimbotESP()
    end
end)

