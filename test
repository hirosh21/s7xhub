        if autoParryBallConn then
            autoParryBallConn:Disconnect()
            autoParryBallConn = nil
        end
    end

    -- Monitora a adição de novas bolas no mapa de forma segura
    local ballsFolder = workspace:FindFirstChild("Balls")
    if ballsFolder then
        ballsFolder.ChildAdded:Connect(function()
            if not _G.AutoParryBB then return end
            task.wait(0.1) 
            local ball = getBladeBall()
            if not ball then return end
            
            resetBallConnection()
            autoParryBallConn = ball:GetAttributeChangedSignal("target"):Connect(function()
                isParried = false 
            end)
        end)
    end

    -- Conecta a lógica ao seu botão do Painel
    GUI.AutoParryBtn.MouseButton1Click:Connect(function()
