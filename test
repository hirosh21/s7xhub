-- [ MOTOR DE VFX ABSOLUTO E ÁUDIO 3D (SWIRL) ]
local function PlayDashEffect(pos, direction)
    task.spawn(function()
        -- 1. Âncora Física (Base para o Áudio e VFX)
        local anchor = Instance.new("Part")
        anchor.Transparency = 1
        anchor.Anchored = true
        anchor.CanCollide = false
        anchor.Size = Vector3.new(0.1, 0.1, 0.1)
        -- A âncora rotaciona para olhar na direção do movimento (crucial para o Swirl cortar o ar)
        anchor.CFrame = CFrame.new(pos, pos + direction)
        anchor.Parent = workspace
        
        -- 2. ÁUDIO 3D PROFISSIONAL (Volume 50%)
        local sfx = Instance.new("Sound")
        sfx.SoundId = "rbxassetid://140324602533286"
        sfx.Volume = 0.5 
        sfx.RollOffMode = Enum.RollOffMode.Linear
        sfx.RollOffMinDistance = 10
        sfx.RollOffMaxDistance = 80
        sfx.Parent = anchor
        sfx:Play()
        
        -- 3. MOTOR DO EFEITO SWIRL NATIVO (Sem Download)
        local att = Instance.new("Attachment", anchor)
        local pe = Instance.new("ParticleEmitter", att)
        pe.Texture = "rbxassetid://8096189152"
        
        pe.Color = ColorSequence.new(Color3.fromRGB(240, 69, 255))
        pe.LightEmission = 1
        pe.LightInfluence = 0
        pe.ZOffset = 10
        
        -- O SEGREDO DO CORTE:
        pe.Orientation = Enum.ParticleOrientation.VelocityPerpendicular 
        
        pe.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 6), 
            NumberSequenceKeypoint.new(1, 0)
        })
        pe.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0), 
            NumberSequenceKeypoint.new(1, 1)
        })
        
        -- [ A CORREÇÃO CRÍTICA ]: VelocityPerpendicular exige que a partícula tenha velocidade.
        pe.Speed = NumberRange.new(40, 50) -- Dispara a lâmina rapidamente
        pe.Drag = 8 -- Freia a lâmina bruscamente no ar logo após o disparo
        pe.Lifetime = NumberRange.new(0.3, 0.4)
        pe.EmissionDirection = Enum.NormalId.Back -- Força a emissão para trás (costas do player)
        pe.Enabled = false
        
        pe:Emit(20) -- Dispara 20 partículas juntas para formar uma lâmina densa
        
        -- Limpa a memória
        game:GetService("Debris"):AddItem(anchor, 2)
    end)
end

