    -- Loop de Renderização Extrema (RenderStepped - 0 Latência)
    game:GetService("RunService").RenderStepped:Connect(function()
        for plr, esp in pairs(FpsEspCache) do
            local isVisible = false
            
            if _G.S7xFpsEspEnabled and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                local isEnemy = true
                -- Verifica se são do mesmo time
                if plr.Team and game.Players.LocalPlayer.Team and plr.Team == game.Players.LocalPlayer.Team then 
                    isEnemy = false 
                end
                
                if isEnemy then
                    local hrp = plr.Character.HumanoidRootPart
                    local head = plr.Character:FindFirstChild("Head") or hrp
                    
                    local hrpPos, onScreen = ESPCamera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local headPos = ESPCamera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local legPos = ESPCamera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        
                        local dist = (ESPCamera.CFrame.Position - hrp.Position).Magnitude
                        
                        -- [ O SEGREDO DO ESP: OPACIDADE DINÂMICA ]
                        -- O Range limite de cálculo é de 800 studs. Quando mais perto, alpha vira 1 (Full Visível)
                        local alpha = math.clamp(1 - (dist / 800), 0.15, 1)
                        
                        local height = math.abs(headPos.Y - legPos.Y)
                        local width = height * 0.6

                        pcall(function()
                            -- Posicionamento e Redimensionamento da Box
                            esp.Box.Size = Vector2.new(width, height)
                            esp.Box.Position = Vector2.new(hrpPos.X - width/2, headPos.Y)
                            esp.Box.Transparency = alpha
                            
                            esp.BoxOutline.Size = esp.Box.Size
                            esp.BoxOutline.Position = esp.Box.Position
                            esp.BoxOutline.Transparency = alpha

                            -- Barra de Vida Dinâmica e Alinhada à Box
                            local hpPct = math.clamp(plr.Character.Humanoid.Health / plr.Character.Humanoid.MaxHealth, 0, 1)
                            
                            esp.HealthBg.From = Vector2.new(hrpPos.X - width/2 - 6, headPos.Y)
                            esp.HealthBg.To = Vector2.new(hrpPos.X - width/2 - 6, legPos.Y)
                            esp.HealthBg.Transparency = alpha
                            
                            esp.HealthBar.From = Vector2.new(hrpPos.X - width/2 - 6, legPos.Y)
                            esp.HealthBar.To = Vector2.new(hrpPos.X - width/2 - 6, legPos.Y - (height * hpPct))
                            esp.HealthBar.Color = Color3.fromHSV(0.3 * hpPct, 1, 1) -- Transição de Vermelho p/ Verde
                            esp.HealthBar.Transparency = alpha

                            -- Tracer (Sai da parte debaixo do centro da tela para o pé do inimigo)
                            esp.Tracer.From = Vector2.new(ESPCamera.ViewportSize.X / 2, ESPCamera.ViewportSize.Y)
                            esp.Tracer.To = Vector2.new(hrpPos.X, legPos.Y)
                            esp.Tracer.Transparency = alpha

                            -- Textos de Nome e Distância
                            esp.Name.Position = Vector2.new(hrpPos.X, headPos.Y - 18)
                            esp.Name.Transparency = alpha
                            
                            esp.Dist.Text = math.floor(dist) .. "m"
                            esp.Dist.Position = Vector2.new(hrpPos.X, legPos.Y + 2)
                            esp.Dist.Transparency = alpha

                            isVisible = true
                        end)
                    end
                end
            end

            -- Liga ou desliga as linhas deste jogador baseado nas checagens
            pcall(function()
                for _, d in pairs(esp) do d.Visible = isVisible end
            end)
        end
    end)

