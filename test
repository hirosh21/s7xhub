                elseif target.Parent.Parent:FindFirstChild("Humanoid") then
                    targetPlayer = game:GetService("Players"):GetPlayerFromCharacter(target.Parent.Parent)
                end
            end
            
            if targetPlayer and targetPlayer ~= game.Players.LocalPlayer then
                if bgtTarget == targetPlayer then
                    -- Se clicou no mesmo jogador, DESLIGA a execução (mas mantém armado para o próximo)
                    if bgtLoop then bgtLoop:Disconnect(); bgtLoop = nil end
                    if bgtAnimTrack then bgtAnimTrack:Stop(); bgtAnimTrack = nil end
                    if bgtOriginalGravity then workspace.Gravity = bgtOriginalGravity; bgtOriginalGravity = nil end
                    bgtTarget = nil
                    
                    if type(S7xNotify) == "function" then S7xNotify("BANGET", "Stopped. Still Armed.") end
                else
                    -- Se clicou em um novo jogador, INICIA a execução com ZERO DELAY
                    if bgtLoop then bgtLoop:Disconnect(); bgtLoop = nil end
                    if bgtAnimTrack then bgtAnimTrack:Stop(); bgtAnimTrack = nil end
                    if not bgtOriginalGravity then bgtOriginalGravity = workspace.Gravity end
                    
                    bgtTarget = targetPlayer
                    if type(S7xNotify) == "function" then S7xNotify("BANGET", "LOCKED ON: " .. targetPlayer.Name) end
                    
                    local localPlayer = game.Players.LocalPlayer
                    local myHum = localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid")
                    
                    if myHum then
                        -- Removemos a gravidade para evitar que o Roblox puxe o player para baixo
                        workspace.Gravity = 0
                        
                        -- Injeta a animação original Híbrida
                        local animation = Instance.new("Animation")
                        animation.AnimationId = "rbxassetid://189854234"
                        bgtAnimTrack = myHum:LoadAnimation(animation)
                        bgtAnimTrack:Play()
                        
                        -- O SEGREDO DO ZERO DELAY: Matemática de Oscilação no "Stepped"
                        bgtLoop = game:GetService("RunService").Stepped:Connect(function()
                            -- Proteção anti-crash
                            if not bgtTarget or not bgtTarget.Character or not bgtTarget.Character:FindFirstChild("HumanoidRootPart") or not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                if bgtLoop then bgtLoop:Disconnect(); bgtLoop = nil end
                                if bgtAnimTrack then bgtAnimTrack:Stop(); bgtAnimTrack = nil end
                                if bgtOriginalGravity then workspace.Gravity = bgtOriginalGravity; bgtOriginalGravity = nil end
                                bgtTarget = nil
                                return
                            end
                            
                            local cMyHrp = localPlayer.Character.HumanoidRootPart
                            local cTHrp = bgtTarget.Character.HumanoidRootPart
                            
                            -- Cálculos da Frequência de Impacto (Substitui o antigo TweenService)
                            -- Isso recria o movimento contínuo exato entre -2.5 e -1.3, mas colado no alvo.
                            local speed = 21 -- Frequência da batida (Similar ao Tween 0.15)
                            local amplitude = 0.6 -- Distância percorrida
                            local centerOffset = -1.9 -- Ponto central da posição (-1.3 a -2.5)
                            
                            -- math.sin gera a onda de movimento fluida frame a frame
                            local currentZ = centerOffset + (math.sin(tick() * speed) * amplitude)
                            
                            -- Prende o CFrame com Offset dinâmico e anula a velocidade do corpo para não haver tremores de física
                            cMyHrp.CFrame = cTHrp.CFrame * CFrame.new(0, 0, currentZ)
                            cMyHrp.Velocity = Vector3.zero
                            cMyHrp.RotVelocity = Vector3.zero
                        end)
                    end
                end
            end
        end)
    end
end
