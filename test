            toggleBtn.BackgroundColor3 = Settings[name] and Color3.fromRGB(140, 0, 255) or Color3.fromRGB(30, 20, 25)
            toggleBtn.Text = Settings[name] and "ON" or "OFF"
            toggleBtn.TextColor3 = Settings[name] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
            toggleBtn.Font = Enum.Font.GothamBold
