    _G.ToggleFreeCam = function()
        _G.S7xFreecamEnabled = not _G.S7xFreecamEnabled
        if type(setToggleState) == "function" then setToggleState(GUI.FreeCamBtn, _G.S7xFreecamEnabled) end
        
        local cam = workspace.CurrentCamera
        local isMob = uis.TouchEnabled and not uis.KeyboardEnabled

        if _G.S7xFreecamEnabled then
            if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                game.Players.LocalPlayer.Character.HumanoidRootPart.Anchored = true
            end

            fcPos = cam.CFrame.Position
            local rx, ry, rz = cam.CFrame:ToEulerAnglesYXZ()
            fcRot = Vector2.new(rx, ry)
            cam.CameraType = Enum.CameraType.Scriptable
            
            if isMob and GUI.FCMobileUI then GUI.FCMobileUI.Visible = true end

            fcLoop = game:GetService("RunService").RenderStepped:Connect(function(dt)
                local moveVector = Vector3.new()
                
                if uis:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + Vector3.new(0, 0, -1) end
                if uis:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector + Vector3.new(0, 0, 1) end
                if uis:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector + Vector3.new(-1, 0, 0) end
                if uis:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + Vector3.new(1, 0, 0) end
                if uis:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
                if uis:IsKeyDown(Enum.KeyCode.LeftControl) then moveVector = moveVector + Vector3.new(0, -1, 0) end
                
                local camRotCFrame = CFrame.Angles(0, fcRot.Y, 0) * CFrame.Angles(fcRot.X, 0, 0)
                local finalMove = camRotCFrame:VectorToWorldSpace(moveVector)
                
                if isMob and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
                    local md = game.Players.LocalPlayer.Character.Humanoid.MoveDirection
                    if md.Magnitude > 0 then finalMove = finalMove + md end
                end
                
                if _G.FC_Up then finalMove = finalMove + Vector3.new(0, 1, 0) end
                if _G.FC_Down then finalMove = finalMove + Vector3.new(0, -1, 0) end
                
                if finalMove.Magnitude > 0 then
                    finalMove = finalMove.Unit * (_G.FreecamSpeed or 50) * dt
                end
                
                fcPos = fcPos + finalMove
                cam.CFrame = CFrame.new(fcPos) * camRotCFrame
            end)
            if type(S7xNotify) == "function" then S7xNotify("PRO FREECAM", "Câmera desvinculada. Você é um fantasma.") end
        else
            if fcLoop then fcLoop:Disconnect() fcLoop = nil end
            cam.CameraType = Enum.CameraType.Custom
            if GUI.FCMobileUI then GUI.FCMobileUI.Visible = false end
            
            isDragging = false
            dragInput = nil
            uis.MouseBehavior = Enum.MouseBehavior.Default
            
            local hum = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
            if hum then cam.CameraSubject = hum end
            if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                game.Players.LocalPlayer.Character.HumanoidRootPart.Anchored = false
            end
            if type(S7xNotify) == "function" then S7xNotify("PRO FREECAM", "Câmera restaurada ao corpo.") end
        end
    end

