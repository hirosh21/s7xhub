-- 7. Lógica de Scan da Rede (Presence)
GUI.LoadAdminPlayers = function()
    if GUI.RefreshAdminBtn.Text == "SCANNING..." then return end
    GUI.RefreshAdminBtn.Text = "SCANNING..."
    
    for _, v in pairs(GUI.AdminListContainer:GetChildren()) do
        if v:IsA("Frame") then v:Destroy() end
    end
    
    task.spawn(function()
        local HttpService = game:GetService("HttpService")
        local res = _G.SupabaseReq("/presence?select=id,payload", "GET")
        
        if res and res.Body then
            local decoded = HttpService:JSONDecode(res.Body)
            if type(decoded) == "table" and not decoded.error then
                local currentTime = os.time()
                
                for _, row in ipairs(decoded) do
                    local payload = row.payload
                    if type(payload) == "string" then pcall(function() payload = HttpService:JSONDecode(payload) end) end
                    
                    if type(payload) == "table" then
                        local uid = tonumber(row.id)
                        local lastSeen = payload.Time or payload.t or 0
                        
                        -- Identifica jogadores ativos nos últimos 5 minutos (300 segundos)
                        if (currentTime - lastSeen) <= 300 then
                            local s, username = pcall(function() return game:GetService("Players"):GetNameFromUserIdAsync(uid) end)
                            if not s then username = "Unknown" end
                            
                            local tag = payload.Tag or payload.tg or "User"
                            local jobId = payload.job_id or payload.j or "Unknown"
                            
                            GUI.RenderAdminPlayerCard(uid, username, jobId, tag)
                        end
                    end
                end
            end
        end
        GUI.RefreshAdminBtn.Text = "REFRESH NETWORK PLAYERS"
    end)
end

GUI.RefreshAdminBtn.MouseButton1Click:Connect(GUI.LoadAdminPlayers)

