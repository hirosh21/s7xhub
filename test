local function addUIGrid(parent, cellWidth)
    local layout = Instance.new("UIGridLayout", parent)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.CellPadding = UDim2.new(0, 6, 0, 8)
    layout.CellSize = UDim2.new(cellWidth, 0, 0, 36) -- Altura corrigida para os novos botões Premium
    local padding = Instance.new("UIPadding", parent)
    padding.PaddingTop = UDim.new(0, 10)
    return layout
end

