-- [ MOTOR DE DETECÇÃO HEURÍSTICA DE CARGOS ]
local function CheckForAdminPermissions(plr)
    local isThreat = false
    local threatReason = "Unknown"
    local threatRole = "Staff"

    pcall(function()
        -- 1. Verifica se o jogador é o dono do jogo ou da Place
        if game.CreatorType == Enum.CreatorType.User and plr.UserId == game.CreatorId then
            isThreat = true
            threatReason = "GAME OWNER"
            threatRole = "Creator"
            return
        elseif game.CreatorType == Enum.CreatorType.Group then
            local s, rank = pcall(function() return plr:GetRoleInGroup(game.CreatorId) end)
            if s and rank then
                local lowRank = string.lower(rank)
                if string.find(lowRank, "admin") or string.find(lowRank, "mod") or string.find(lowRank, "dev") or string.find(lowRank, "owner") or string.find(lowRank, "creator") then
                    isThreat = true
                    threatReason = "GROUP GAME STAFF"
                    threatRole = rank
                    return
                end
            end
        end

        -- 2. Verifica se está em um Time de Moderação
        if plr.Team then
            local tName = string.lower(plr.Team.Name)
            if string.find(tName, "admin") or string.find(tName, "mod") or string.find(tName, "staff") or string.find(tName, "owner") then
                isThreat = true
                threatReason = "STAFF TEAM"
                threatRole = plr.Team.Name
                return
            end
        end

        -- 3. Verifica os Cargos no Servidor (Leaderstats)
        local ls = plr:FindFirstChild("leaderstats")
        if ls then
            local roleNames = {"Role", "Cargo", "Rank", "Class", "Group", "Staff"}
            for _, name in ipairs(roleNames) do
                local val = ls:FindFirstChild(name)
                if val and (val:IsA("StringValue") or val:IsA("ObjectValue")) then
                    local valStr = string.lower(tostring(val.Value))
                    if string.find(valStr, "admin") or string.find(valStr, "mod") or string.find(valStr, "staff") or string.find(valStr, "owner") or string.find(valStr, "dev") then
                        isThreat = true
                        threatReason = "SERVER LEADERSTATS"
                        threatRole = tostring(val.Value)
                        return
                    end
                end
            end
        end

        -- 4. Verifica a rede oficial S7x (Legado de Segurança)
        local s, s7xRole = pcall(function() return plr:GetRoleInGroup(34157675) end)
        local ADMIN_ROLES = { ["Marketing"] = true, ["Social Mod"] = true, ["Helper"] = true, ["Supervisor"] = true, ["Manager"] = true, ["Contributor"] = true, ["Developer"] = true, ["Owner"] = true, ["Creator"] = true }
        if s and s7xRole and ADMIN_ROLES[s7xRole] then
            isThreat = true
            threatReason = "S7X NETWORK ADMIN"
            threatRole = s7xRole
            return
        end
    end)

    return isThreat, threatReason, threatRole
end

