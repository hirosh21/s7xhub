    local function FireNotify(title, text)
        if type(S7xNotify) == "function" then 
            S7xNotify(title, text) 
        else
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = title,
                    Text = text,
                    Duration = 6,
                    Icon = "rbxassetid://135351041318579" -- Ícone do S7x
                })
            end)
        end
    end

    if _G.TomatoSpamEnabled then
        if isMob then
            -- MODO MOBILE: Mostra o widget tático e oculta o aviso de teclas
            FireNotify("TOMATO SPAM", "Use os botões flutuantes para mirar e atacar.")
            if GUI.TomatoWidget then GUI.TomatoWidget.Visible = true end
        else
