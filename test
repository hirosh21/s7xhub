-- [ 2. FORMATADOR DE CÓDIGO LUA (GERADOR DE SCRIPT) ]
_G.S7xFormatArgs = function(args)
    local function serialize(val, depth)
        depth = depth or 0
        if depth > 5 then return '"[Max Depth]"' end
        local t = typeof(val)
        if t == "string" then return '"' .. string.gsub(val, '"', '\\"') .. '"'
        elseif t == "Instance" then return val:GetFullName()
        elseif t == "number" or t == "boolean" then return tostring(val)
        elseif t == "Vector3" then return string.format("Vector3.new(%f, %f, %f)", val.X, val.Y, val.Z)
        elseif t == "CFrame" then return string.format("CFrame.new(%f, %f, %f)", val.X, val.Y, val.Z)
        elseif t == "Color3" then return string.format("Color3.new(%f, %f, %f)", val.R, val.G, val.B)
        elseif t == "table" then
            local str = "{\n"
            for k, v in pairs(val) do
                local keyStr = (type(k) == "string") and '["'..k..'"]' or "["..tostring(k).."]"
                str = str .. string.rep("  ", depth + 1) .. keyStr .. " = " .. serialize(v, depth + 1) .. ",\n"
            end
            return str .. string.rep("  ", depth) .. "}"
        else return '"[' .. t .. ']"' end
    end
    
    local formatted = ""
    for i, v in ipairs(args) do
        formatted = formatted .. serialize(v)
        if i < #args then formatted = formatted .. ", " end
    end
    return formatted
end

