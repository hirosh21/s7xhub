local function getMyTag()
    if _G.EquippedTag then return _G.EquippedTag end
    local success, role = pcall(function() return game.Players.LocalPlayer:GetRoleInGroup(34157675) end) 
    local isPerm = false
    if success and role and role ~= "Guest" then 
        if TagAdminRoles and (TagAdminRoles[role] or role == "Supreme" or role == "Ultimate" or role == "Influencer") then isPerm = true end
        if isPerm then
            if role == "Developers" then return "Dev" end
            if role == "Creator" then return "Owner" end
            if role == "Disigner" then return "Designer" end
            return role 
        end
    end
    if type(isTesterActive) == "function" and isTesterActive() and not isPerm then return "Tester" end
    return (type(GetFirebaseRank) == "function" and GetFirebaseRank(game.Players.LocalPlayer)) or (success and role and role ~= "Guest" and role) or "User"
end

local function getTagColorSeq(tagName)
    local uidStr = tostring(game.Players.LocalPlayer.UserId)
    local baseColor = Color3.fromRGB(255, 255, 255)
    local c2 = Color3.fromRGB(200, 200, 200)
    
    if tagName == "Custom" and _G.CustomTagsConfig and _G.CustomTagsConfig[uidStr] then
        local data = _G.CustomTagsConfig[uidStr]
        baseColor = _G.S7xParseColor(data.Color, Color3.fromRGB(0, 255, 150))
        c2 = _G.S7xParseColor(data.Color2, Color3.fromRGB(255, 255, 255))
        local effect = data.Effect or "Solid"
        
        if effect == "Rainbow" then
            return ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)), ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0,0,255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0))})
        elseif effect == "Fire" then
            return ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255,50,0)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,200,0)), ColorSequenceKeypoint.new(1, Color3.fromRGB(180,0,0))})
        elseif effect == "Cosmic" then
            return ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(138,43,226)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,229,255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255,20,147))})
        elseif effect == "Gold Luxury" then
            return ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(218,165,32)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,255,255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(184,134,11))})
        elseif effect == "Duo-chrome" then
            return ColorSequence.new({ColorSequenceKeypoint.new(0, baseColor), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,255,255)), ColorSequenceKeypoint.new(1, c2)})
        else
            return ColorSequence.new({ColorSequenceKeypoint.new(0, baseColor), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,255,255)), ColorSequenceKeypoint.new(1, baseColor)})
        end
    end

    local tagColors = {
        ["Owner"] = Color3.fromRGB(210, 210, 210), ["Co-Owner"] = Color3.fromRGB(150, 100, 50),
        ["Friends"] = Color3.fromRGB(173, 216, 230), ["Supreme"] = Color3.fromRGB(138, 43, 226),
        ["Contributor"] = Color3.fromRGB(255, 85, 0), ["Helper"] = Color3.fromRGB(255, 200, 0),
        ["Supervisor"] = Color3.fromRGB(60, 0, 90), ["Manager"] = Color3.fromRGB(120, 0, 0),
        ["Developer"] = Color3.fromRGB(180, 140, 0), ["Marketing"] = Color3.fromRGB(0, 150, 0),
        ["Influencer"] = Color3.fromRGB(216, 175, 255), ["Ultimate"] = Color3.fromRGB(0, 255, 255),
        ["Designer"] = Color3.fromRGB(0, 100, 255), ["Tester"] = Color3.fromRGB(139, 69, 19),
        ["Member"] = Color3.fromRGB(200, 200, 200), ["User"] = Color3.fromRGB(150, 150, 150)
    }
    
    baseColor = tagColors[tagName] or Color3.fromRGB(255, 255, 255)
    -- Retorna um efeito metálico brilhante por padrão para as tags do sistema
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, baseColor),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, baseColor)
    })
end

local function getBaseColor(tagName)
    local seq = getTagColorSeq(tagName)
    return seq.Keypoints[1].Value
end

