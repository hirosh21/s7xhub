    local function PlayFlyAnimation(hum, id)
        if currentFlyAnimId == id then return end
        currentFlyAnimId = id
        if activeFlyAnim then activeFlyAnim:Stop(0.3); activeFlyAnim = nil end
        if id == 0 then return end
        
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://" .. tostring(id)
            activeFlyAnim = animator:LoadAnimation(anim)
            activeFlyAnim.Priority = Enum.AnimationPriority.Action4 
            activeFlyAnim:Play(0.3)
        end
    end

    local function toggleFly()
        flyEnabled = not flyEnabled
        if type(setToggleState) == "function" then setToggleState(GUI.FlyBtn, flyEnabled) end
        
        local char = game.Players.LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        local animate = char:FindFirstChild("Animate") 
        
        if flyEnabled and hrp and hum then
            hum.PlatformStand = true
            if animate then animate.Disabled = true end 
            
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop(0.2) end end

            if flyBG then flyBG:Destroy() end
            if flyBV then flyBV:Destroy() end
            
            flyBG = Instance.new("BodyGyro", hrp); flyBG.P = 9e4; flyBG.maxTorque = Vector3.new(9e9, 9e9, 9e9); flyBG.cframe = hrp.CFrame
            flyBV = Instance.new("BodyVelocity", hrp); flyBV.velocity = Vector3.new(0, 0, 0); flyBV.maxForce = Vector3.new(9e9, 9e9, 9e9)
            
            flySpeed = 0; ctrl = {f = 0, b = 0, l = 0, r = 0}; lastctrl = {f = 0, b = 0, l = 0, r = 0}
            
            toggleFlyVFX(true, hrp)
            PlayFlyAnimation(hum, 10714347256)
        else
            if hum then hum.PlatformStand = false; hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
            if animate then animate.Disabled = false end
            
            PlayFlyAnimation(hum, 0)
            toggleFlyVFX(false, hrp)
            
            if flyBG then flyBG:Destroy(); flyBG = nil end
            if flyBV then flyBV:Destroy(); flyBV = nil end
            flySpeed = 0
        end
    end

    game:GetService("RunService").RenderStepped:Connect(function()
        if flyEnabled and flyBV and flyBG and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hum = game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
            local camCF = workspace.CurrentCamera.CoordinateFrame
            
            ctrl = {f = 0, b = 0, l = 0, r = 0}
            local uis = game:GetService("UserInputService")
            if uis:IsKeyDown(Enum.KeyCode.W) then ctrl.f = 1 end
            if uis:IsKeyDown(Enum.KeyCode.S) then ctrl.b = -1 end
            if uis:IsKeyDown(Enum.KeyCode.A) then ctrl.l = -1 end
            if uis:IsKeyDown(Enum.KeyCode.D) then ctrl.r = 1 end
            
            local isMobile = uis.TouchEnabled and not uis.KeyboardEnabled
            if isMobile and hum and hum.MoveDirection.Magnitude > 0 then
                local rel = camCF:VectorToObjectSpace(hum.MoveDirection)
                if rel.Z < -0.2 then ctrl.f = 1 end
                if rel.Z > 0.2 then ctrl.b = -1 end
                if rel.X < -0.2 then ctrl.l = -1 end
                if rel.X > 0.2 then ctrl.r = 1 end
            end

            if hum then
                if ctrl.f == 1 then PlayFlyAnimation(hum, 10714177846)
                elseif ctrl.b == -1 or ctrl.l == -1 or ctrl.r == 1 then PlayFlyAnimation(hum, 10147823318)
                else PlayFlyAnimation(hum, 10714347256) end
            end

            if ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0 then
                flySpeed = flySpeed + flySpeedValue * 0.05
                if flySpeed > flySpeedValue then flySpeed = flySpeedValue end
            elseif not (ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0) and flySpeed ~= 0 then
                flySpeed = flySpeed - flySpeedValue * 0.10
                if flySpeed < 0 then flySpeed = 0 end
            end
            
            if (ctrl.l + ctrl.r) ~= 0 or (ctrl.f + ctrl.b) ~= 0 then
                flyBV.velocity = ((camCF.LookVector * (ctrl.f+ctrl.b)) + ((camCF * CFrame.new(ctrl.l+ctrl.r,(ctrl.f+ctrl.b)*0.2,0).Position) - camCF.Position)) * flySpeed
                lastctrl = {f = ctrl.f, b = ctrl.b, l = ctrl.l, r = ctrl.r}
            elseif (ctrl.l + ctrl.r) == 0 and (ctrl.f + ctrl.b) == 0 and flySpeed ~= 0 then
                flyBV.velocity = ((camCF.LookVector * (lastctrl.f+lastctrl.b)) + ((camCF * CFrame.new(lastctrl.l+lastctrl.r,(lastctrl.f+lastctrl.b)*0.2,0).Position) - camCF.Position)) * flySpeed
            else
                flyBV.velocity = Vector3.new(0, math.sin(tick() * 4) * 0.5, 0)
            end
            
            flyBG.cframe = camCF * CFrame.Angles(-math.rad((ctrl.f+ctrl.b) * 50 * flySpeed / flySpeedValue), 0, 0)
        end
    end)
    GUI.FlyBtn.MouseButton1Click:Connect(toggleFly)

    local speedEnabled = false
    local function toggleSpeed()
        speedEnabled = not speedEnabled; setToggleState(GUI.SpeedBtn, speedEnabled)
        if not speedEnabled and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16 end
    end
    game:GetService("RunService").RenderStepped:Connect(function() if speedEnabled and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = walkSpeedValue end end)
    GUI.SpeedBtn.MouseButton1Click:Connect(toggleSpeed)
end)

