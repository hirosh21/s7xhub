local function addKeybindBox(btn, action)
    if not btn then return end 
    
    local keyBox = Instance.new("TextBox", btn)
    keyBox.Size = UDim2.new(0, 20, 0, 20)
    keyBox.BackgroundColor3 = Color3.fromRGB(20, 18, 25)
    keyBox.TextColor3 = Color3.fromRGB(170, 0, 255)
    keyBox.Font = Enum.Font.GothamBold
    keyBox.TextSize = 11
    
    -- Tradutor para mostrar o número visualmente na caixinha
    local function getBindName(keyCode)
        if not keyCode then return "" end
        local n = keyCode.Name
        local numMap = {One="1", Two="2", Three="3", Four="4", Five="5", Six="6", Seven="7", Eight="8", Nine="9", Zero="0"}
        return numMap[n] or n
    end

    keyBox.Text = getBindName(bindKeys[action])
    keyBox.PlaceholderText = "..."
    Instance.new("UICorner", keyBox).CornerRadius = UDim.new(0, 4)
    
    local kbStrk = Instance.new("UIStroke", keyBox)
    kbStrk.Color = Color3.fromRGB(80, 40, 120)
    kbStrk.Thickness = 1
    
    -- O SEGREDO DO ESPAÇAMENTO
    if btn:FindFirstChild("ToggleBG") ~= nil or btn:FindFirstChild("SysToggleBG") ~= nil then 
        keyBox.Position = UDim2.new(1, -74, 0.5, -10)
    else 
        keyBox.Position = UDim2.new(1, -28, 0.5, -10) 
    end

    -- Mapeamento nativo para o Roblox ler números do teclado
    local numToKey = {
        ["0"] = Enum.KeyCode.Zero, ["1"] = Enum.KeyCode.One, ["2"] = Enum.KeyCode.Two,
        ["3"] = Enum.KeyCode.Three, ["4"] = Enum.KeyCode.Four, ["5"] = Enum.KeyCode.Five,
        ["6"] = Enum.KeyCode.Six, ["7"] = Enum.KeyCode.Seven, ["8"] = Enum.KeyCode.Eight,
        ["9"] = Enum.KeyCode.Nine
    }

    keyBox.FocusLost:Connect(function()
        local rawInput = string.upper(string.sub(keyBox.Text, 1, 1))
        local code = numToKey[rawInput]
        
        if not code then
            local s, r = pcall(function() return Enum.KeyCode[rawInput] end)
            if s then code = r end
        end
        
        if code and rawInput ~= "" then 
            -- [ 🛡️ MOTOR ANTI-DUPLICAÇÃO ]: Verifica se a tecla já existe em outra Bind
            local isDuplicate = false
            local duplicateOwner = ""
            
            for actName, actKey in pairs(bindKeys) do
                if actName ~= action and actKey == code then
                    isDuplicate = true
                    duplicateOwner = actName
                    break
                end
            end
            
            if isDuplicate then
                -- Bloqueia a alteração, avisa o usuário e reverte a caixinha
                if type(S7xNotify) == "function" then 
                    S7xNotify("BIND ERROR", "Tecla [" .. code.Name .. "] já está em uso por: " .. string.upper(duplicateOwner)) 
                end
                
                -- Alerta visual de erro (Pisca vermelho)
                local ts = game:GetService("TweenService")
                pcall(function() ts:Create(kbStrk, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 50, 50)}):Play() end)
                task.delay(0.5, function() pcall(function() ts:Create(kbStrk, TweenInfo.new(0.3), {Color = Color3.fromRGB(80, 40, 120)}):Play() end) end)
                
                keyBox.Text = getBindName(bindKeys[action]) -- Restaura a antiga
            else
                -- Validação bem sucedida
                bindKeys[action] = code 
                keyBox.Text = rawInput 
                
                -- Feedback e Auto-Save
                if type(S7xNotify) == "function" then S7xNotify("BIND SAVED", string.upper(action) .. " vinculado em [" .. code.Name .. "]") end
                if type(SaveS7xSettings) == "function" then task.spawn(SaveS7xSettings) end
            end
        else 
            -- Se apagar a caixinha (Unbind)
            bindKeys[action] = nil
            keyBox.Text = "" 
            if type(S7xNotify) == "function" then S7xNotify("BIND REMOVED", "Atalho removido.") end
            if type(SaveS7xSettings) == "function" then task.spawn(SaveS7xSettings) end
        end
    end)
end


