    _G.PhantomClipEnabled = false
    local phantomClipConn = nil
    
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    GUI.PhantomClipBtn.MouseButton1Click:Connect(function()
        _G.PhantomClipEnabled = not _G.PhantomClipEnabled
        if type(setToggleState) == "function" then setToggleState(GUI.PhantomClipBtn, _G.PhantomClipEnabled) end

        if _G.PhantomClipEnabled then
            if phantomClipConn then phantomClipConn:Disconnect() end
            
            phantomClipConn = RS.Stepped:Connect(function()
                local myChar = player.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myHrp then return end

                local myPos = myHrp.Position

                -- [ 1. NEUTRALIZAÇÃO TOTAL DE TOOLS E ACESSÓRIOS NOS JOGADORES ]
                for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                    if p ~= player and p.Character then
                        local char = p.Character
                        local tHrp = char:FindFirstChild("HumanoidRootPart")
                        
                        -- Otimização: Apenas processa jogadores a menos de 60 studs (Zero Lag)
                        if tHrp and (tHrp.Position - myPos).Magnitude < 60 then
                            for _, child in ipairs(char:GetChildren()) do
                                if child:IsA("Tool") or child:IsA("Accessory") then
                                    for _, part in ipairs(child:GetDescendants()) do
                                        if part:IsA("BasePart") then
                                            -- Remove 100% da física, massa, peso e colisão
                                            part.CanCollide = false
                                            part.Massless = true
                                            part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                                            
                                            -- Se a Tool tentar ser usada para Fling (giro/velocidade anômala)
                                            if part.Velocity.Magnitude > 50 or part.RotVelocity.Magnitude > 30 then
                                                part.Velocity = Vector3.zero
                                                part.RotVelocity = Vector3.zero
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                -- [ 2. ESCUDO DE PROXIMIDADE (ITENS SOLTOS NO CHÃO, DADOS E OBJETOS ARREMESSADOS) ]
                params.FilterDescendantsInstances = {myChar}
                -- Raio de 12 studs: Cobre exatamente seu espaço vital bloqueando arremessos
                local nearbyParts = workspace:GetPartBoundsInRadius(myPos, 12, params)
                
                for i = 1, #nearbyParts do
                    local part = nearbyParts[i]
                    if not part.Anchored then
                        local isItem = part:FindFirstAncestorWhichIsA("Tool") or part:FindFirstAncestorWhichIsA("Accessory")
                        local isFlinging = part.Velocity.Magnitude > 50 or part.RotVelocity.Magnitude > 30
                        
                        -- Se for um item no chão (como o dado) ou uma peça voando na sua direção
                        if isItem or isFlinging then
                            part.CanCollide = false
                            part.Massless = true
                            -- Zera a densidade e atrito (Impede o Roblox de calcular impacto)
                            part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                            
                            if isFlinging then
                                part.Velocity = Vector3.zero
                                part.RotVelocity = Vector3.zero
                                part.AssemblyLinearVelocity = Vector3.zero
                                part.AssemblyAngularVelocity = Vector3.zero
                            end
                        end
                    end
                end
            end)
            
            if type(S7xNotify) == "function" then S7xNotify("NOCLIP ITEM", "Física e Massa de Itens 100% Anulada.") end
        else
            if phantomClipConn then phantomClipConn:Disconnect(); phantomClipConn = nil end
            if type(S7xNotify) == "function" then S7xNotify("NOCLIP ITEM", "Colisão padrão restaurada.") end
        end
    end)

