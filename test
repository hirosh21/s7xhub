    S7xIsShiftLocked = not S7xIsShiftLocked
    if type(setToggleState) == "function" then setToggleState(GUI.ShiftLockBtn, S7xIsShiftLocked) end
    
    if S7xIsShiftLocked then
        if type(S7xNotify) == "function" then S7xNotify("SHIFT LOCK", "Câmera e movimento travados.") end
        
        -- Ajuste imediato do deslocamento da câmera
        pcall(function()
            local char = game.Players.LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            if hum then 
                hum.CameraOffset = Vector3.new(1.75, 0, 0) 
                hum.AutoRotate = false -- Desliga a rotação base para evitar conflitos
            end
        end)

        -- Previne loops duplicados
        if S7xShiftConn_RS then S7xShiftConn_RS:Disconnect() end
        
        -- Motor de travamento (Garante que o corpo siga a câmera a cada frame)
        S7xShiftConn_RS = game:GetService("RunService").RenderStepped:Connect(function()
            if S7xIsShiftLocked then
                pcall(function()
                    -- Força o mouse no centro da tela (Dispositivos Mobile ignoram isso nativamente, o que é perfeito)
                    game:GetService("UserInputService").MouseBehavior = Enum.MouseBehavior.LockCenter
                    
                    local char = game.Players.LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChild("Humanoid")
                    local cam = workspace.CurrentCamera
                    
                    if hrp and hum and hum.Health > 0 then
                        -- Extrai a direção da câmera e força o personagem a olhar para lá
                        local lookVector = cam.CFrame.LookVector
                        local targetLook = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
                        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + targetLook)
                    end
                end)
            end
        end)
