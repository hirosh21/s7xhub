    -- [ 2. LÓGICA DE RASTREAMENTO INTELIGENTE (ZERO LAG) ]
    -- O motor calcula matematicamente se o mouse colidiu com a janela do S7x
    local function isHovering(element, mousePos)
        if not element or not element.Visible then return false end
        local pos = element.AbsolutePosition
        local size = element.AbsoluteSize
        local inset = game:GetService("GuiService"):GetGuiInset()
        local myY = mousePos.Y - inset.Y
        return (mousePos.X >= pos.X and mousePos.X <= pos.X + size.X and
                myY >= pos.Y and myY <= pos.Y + size.Y)
    end

    if _G.S7xCursorLoop then _G.S7xCursorLoop:Disconnect() end
    _G.S7xCursorLoop = rs.RenderStepped:Connect(function()
        if isMobile then return end
        
        local mousePos = uis:GetMouseLocation()
        local inset = game:GetService("GuiService"):GetGuiInset()
        
        -- Checa se o mouse invadiu o painel principal, a bolinha, ou os menus S7x
        local overMain = isHovering(GUI.MainFrame, mousePos)
        local overBtn = isHovering(GUI.OpenBtn, mousePos)
        local overMini = isHovering(GUI.MiniMenu, mousePos)
        local overNotify = isHovering(GUI.NotifyContainer, mousePos)
        
        if overMain or overBtn or overMini or overNotify then
            uis.MouseIconEnabled = false -- Some com o mouse nativo
            GUI.CustomCursor.Visible = true
            -- Renderiza o novo mouse no local exato do hardware
            GUI.CustomCursor.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y - inset.Y)
        else
            uis.MouseIconEnabled = true -- Devolve o mouse normal do jogo
            GUI.CustomCursor.Visible = false
        end
    end)

