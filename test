ApplyOrUpdateTag = function(targetPlayer)
    if not targetPlayer then return end
    local char_tgt = targetPlayer.Character
    if not char_tgt or (char_tgt:FindFirstChild("Humanoid") and char_tgt.Humanoid.Health <= 0) then return end
    
    local head_tgt = char_tgt:FindFirstChild("Head") or char_tgt:FindFirstChild("HumanoidRootPart")
    if not head_tgt then return end

    -- Hierarquia Absoluta: Puxa o cargo base do Cache da Nuvem primeiro
    local fRank = (type(GetFirebaseRank) == "function" and GetFirebaseRank(targetPlayer)) or "User"
    if fRank == "Creator" then fRank = "Owner" end
    if fRank == "Developers" or fRank == "Dev" then fRank = "Developer" end

    local rankName_tgt = fRank
    local userCustomData_tgt = _G.CustomTagsConfig and _G.CustomTagsConfig[tostring(targetPlayer.UserId)]
    
    if targetPlayer == game.Players.LocalPlayer then
        rankName_tgt = _G.EquippedTag or fRank
    else
        local isActiveUser = (_G.S7xUsers and _G.S7xUsers[targetPlayer.UserId]) or (_G.PresenceTags and _G.PresenceTags[targetPlayer.UserId])
        if not isActiveUser then
            local existing = head_tgt:FindFirstChild("S7x_ProTag")
            if existing then existing:Destroy() end
            return 
        end
        
        -- O SEGREDO DO SYNC: Se a rede enviar "User" (bug), forçamos o cargo Real (Developer, Supreme, etc)
        local presenceTag = _G.PresenceTags and _G.PresenceTags[targetPlayer.UserId]
        if presenceTag and presenceTag ~= "User" then
            rankName_tgt = presenceTag
        else
            rankName_tgt = fRank 
        end
    end

    if rankName_tgt == "None" then
        local existing = head_tgt:FindFirstChild("S7x_ProTag")
        if existing then existing:Destroy() end
        return
    end

    -- Lógica de Tradução de Tags Customizadas ("Lulu", "Hirosh", etc)
    local displayName_tgt = rankName_tgt
    local desiredFontName = "GothamBlack" -- Fonte padrão

    if rankName_tgt == "Custom" then
        if userCustomData_tgt then
            if userCustomData_tgt.CustomName and userCustomData_tgt.CustomName ~= "" then 
                displayName_tgt = userCustomData_tgt.CustomName 
            end
            if userCustomData_tgt.Font then desiredFontName = userCustomData_tgt.Font end
        else
            displayName_tgt = "Custom"
        end
    else
        local configForName_tgt = _G.CustomTagsConfig and _G.CustomTagsConfig[rankName_tgt]
        if configForName_tgt then
            if configForName_tgt.CustomName and configForName_tgt.CustomName ~= "" then
                displayName_tgt = configForName_tgt.CustomName 
            end
            if configForName_tgt.Font then desiredFontName = configForName_tgt.Font end
        end
    end

    -- Conversão segura de string para Enum de Fonte
    local successFont, desiredFontEnum = pcall(function() return Enum.Font[desiredFontName] end)
    if not successFont or not desiredFontEnum then desiredFontEnum = Enum.Font.GothamBlack end

    -- [ OTIMIZAÇÃO EXTREMA ]: Reciclagem visual limpa para evitar flicker e lag
    local needsRebuild = true
    local existingTag = head_tgt:FindFirstChild("S7x_ProTag")
    
    if existingTag then
        local lbl = existingTag:FindFirstChild("Label")
        if lbl and lbl.Text == displayName_tgt and lbl.Font == desiredFontEnum and SpecialTags[targetPlayer.UserId] and SpecialTags[targetPlayer.UserId].Rank == rankName_tgt then
            needsRebuild = false
        end
    end

    if needsRebuild then
        for _, v in ipairs(head_tgt:GetChildren()) do
            if v.Name == "S7x_ProTag" then v:Destroy() end
        end

        local newTag = Instance.new("BillboardGui")
        newTag.Name = "S7x_ProTag"
        newTag.Adornee = head_tgt
        newTag.Size = UDim2.new(3.5, 0, 0.8, 0) 
        newTag.StudsOffset = Vector3.new(0, 4.0, 0) 
        newTag.AlwaysOnTop = true
        newTag.MaxDistance = 100 
        newTag.Enabled = _G.S7xTagVisible
        newTag.Parent = head_tgt

        local textLabel_tgt = Instance.new("TextLabel", newTag)
        textLabel_tgt.Name = "Label"
        textLabel_tgt.Size = UDim2.new(1, 0, 1, 0)
        textLabel_tgt.BackgroundTransparency = 1
        textLabel_tgt.Font = desiredFontEnum -- Aplica a fonte escolhida e salva no Enum
        textLabel_tgt.TextScaled = true
        textLabel_tgt.TextStrokeTransparency = 0
        textLabel_tgt.Text = displayName_tgt
        
        local grad_tgt = Instance.new("UIGradient", textLabel_tgt)
        grad_tgt.Name = "ShineGradient"
        grad_tgt.Rotation = 45 
        
        game:GetService("TweenService"):Create(newTag, TweenInfo.new(1.2, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {StudsOffset = Vector3.new(0, 3.2, 0)}):Play()
        
        local textConstraint_tgt = Instance.new("UITextSizeConstraint", textLabel_tgt)
        textConstraint_tgt.MaxTextSize = (rankName_tgt == "Developer" or rankName_tgt == "Supreme") and 9 or 12

        if SpecialTags[targetPlayer.UserId] and SpecialTags[targetPlayer.UserId].Label and SpecialTags[targetPlayer.UserId].Label.Parent then
            pcall(function() SpecialTags[targetPlayer.UserId].Label.Parent:Destroy() end)
        end
        SpecialTags[targetPlayer.UserId] = {Label = textLabel_tgt, Rank = rankName_tgt, Head = head_tgt}
    end
