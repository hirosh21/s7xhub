        -- ANIMAÇÃO DE GRADIENTE EM TEMPO REAL NO NOME
        if GUI.NameGradient and GUI.PlayerName.Parent then
            local offsetValue = (now * 0.7) % 2 - 1
            GUI.NameGradient.Offset = Vector2.new(offsetValue, 0)
        end
        
        if now - lastUpdate >= 1 then
            if GUI.FpsLabel and GUI.FpsLabel.Parent then
                local currentTag = getMyTag()
                local tagBaseColor = getBaseColor(currentTag)
                local tagSeq = getTagColorSeq(currentTag)
                
