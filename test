_G.S7xApplyAnimations = function(char)
    if type(_G.S7xCurrentAnimSet) ~= "table" then return end
    
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 5)
        local animate = char:WaitForChild("Animate", 5)
        
        if not animate or not hum then return end
        
        pcall(function()
            local set = _G.S7xCurrentAnimSet
            
            -- Desliga o script nativo para cortar a comunicação
            animate.Disabled = true
            
            local animator = hum:FindFirstChild("Animator") or hum:WaitForChild("Animator", 3)
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    pcall(function() track:Stop(0) end)
                end
            end
            
            local function updateAnim(animName, trackName, id)
                local animObj = animate:FindFirstChild(animName) and animate[animName]:FindFirstChild(trackName)
                local strVal = animate:FindFirstChild(animName)
                
                local rawId = ""
                
                -- Lógica de Retorno ao "DEFAULT STANCE"
                if not id or tostring(id) == "0" or tostring(id) == "" then
                    rawId = _G.S7xOriginalAnims[animName .. "_" .. trackName] or ""
                else
                    rawId = tostring(id):match("%d+") or ""
                end

                -- [ FILTRO DE SEGURANÇA ESTRITO ]: Impede que IDs nulos quebrem o C++ do Roblox
                if rawId ~= "" and rawId ~= "0" then
                    -- Formatação Exata (O Fix principal do Crash)
                    local rbxId = "rbxassetid://" .. rawId
                    local httpId = "http://www.roblox.com/asset/?id=" .. rawId

                    if animObj and animObj:IsA("Animation") then
                        animObj.AnimationId = rbxId
                    end
                    if strVal and strVal:IsA("StringValue") then
                        strVal.Value = httpId
                    end
                end
            end

            updateAnim("idle", "Animation1", set.idle1)
            updateAnim("idle", "Animation2", set.idle2)
            updateAnim("walk", "WalkAnim", set.walk)
            updateAnim("run", "RunAnim", set.run)
            updateAnim("jump", "JumpAnim", set.jump)
            updateAnim("fall", "FallAnim", set.fall)
            updateAnim("climb", "ClimbAnim", set.climb)
            updateAnim("swimidle", "SwimIdle", set.swimidle)
            updateAnim("swim", "Swim", set.swim)
            
            -- Aguarda o motor processar os novos valores antes de reativar
            game:GetService("RunService").RenderStepped:Wait()
            
            animate.Disabled = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Landed) end)
        end)
    end)
end

_G.AntiDeadEnabled = false
_G.ToggleAntiDead = function()
    _G.AntiDeadEnabled = not _G.AntiDeadEnabled
    if type(setToggleState) == "function" then setToggleState(GUI.AntiDeadBtn, _G.AntiDeadEnabled) end
    
    local char = game.Players.LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")

    if _G.AntiDeadEnabled then
        if type(S7xNotify) == "function" then S7xNotify("ANTI DEAD", "Estado de morte desativado. Você está imortal.") end
        
        -- Loop de proteção para garantir que o jogo não force a morte
        if _G.AntiDeadLoop then pcall(function() _G.AntiDeadLoop:Disconnect() end) end
        _G.AntiDeadLoop = game:GetService("RunService").Stepped:Connect(function()
            local c = game.Players.LocalPlayer.Character
            local h = c and c:FindFirstChild("Humanoid")
            if h then
                -- Impede a engine do Roblox de quebrar as juntas mesmo com 0 de vida
                h:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            end
        end)
    else
        if type(S7xNotify) == "function" then S7xNotify("ANTI DEAD", "Mortalidade restaurada.") end
        if _G.AntiDeadLoop then _G.AntiDeadLoop:Disconnect(); _G.AntiDeadLoop = nil end
        
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            -- Se a vida estiver 0 ou menor, mata instantaneamente ao desligar
            if hum.Health <= 0 then
                hum:ChangeState(Enum.HumanoidStateType.Dead)
            end
        end
    end
end

