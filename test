GUI.WalkOnAirBtn.MouseButton1Click:Connect(function()
    _G.WalkOnAirEnabled = not _G.WalkOnAirEnabled
    if type(setToggleState) == "function" then setToggleState(GUI.WalkOnAirBtn, _G.WalkOnAirEnabled) end
    
    if _G.WalkOnAirEnabled then
        -- Coloca a placa no mapa
        woaPart.Parent = workspace
        
        if woaLoop then woaLoop:Disconnect() end
        
        -- Usamos 'Stepped' para atualizar a plataforma ANTES do Roblox puxar o player para baixo
        woaLoop = game:GetService("RunService").Stepped:Connect(function()
            local char = game.Players.LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                local pos = hrp.Position
                -- HRP normalmente fica 3 studs acima do chão. Subtraímos 3.2 para a plataforma ficar exata na sola do pé.
                -- Usamos CFrame.new(pos) para garantir que a placa não gire se o player tombar (evita escorregar).
                woaPart.CFrame = CFrame.new(pos.X, pos.Y - 3.2, pos.Z)
                
                -- Se o player estiver segurando Espaço (Pulando), a placa sobe junto
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) then
                    woaPart.CFrame = woaPart.CFrame * CFrame.new(0, 0.5, 0)
                -- Se segurar LeftControl (Agachar), a placa desce
                elseif game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftControl) then
                    woaPart.CFrame = woaPart.CFrame * CFrame.new(0, -0.5, 0)
                end
            end
        end)
        
        if type(S7xNotify) == "function" then S7xNotify("WALK ON AIR", "You are now walking on the sky.") end
    else
        -- Limpeza total ao desativar
        if woaLoop then woaLoop:Disconnect(); woaLoop = nil end
        woaPart.Parent = nil
        if type(S7xNotify) == "function" then S7xNotify("WALK ON AIR", "Gravity restored.") end
    end
end)

