-- Transformado em Função Global para a Hotkey conseguir acionar
_G.ToggleAntiFlingV2 = function()
    _G.AntiFlingV2Enabled = not _G.AntiFlingV2Enabled
    if type(setToggleState) == "function" then setToggleState(GUI.AntiFlingV2Btn, _G.AntiFlingV2Enabled) end
    
    if _G.AntiFlingV2Enabled then
        ClearAntiFlingV2()
        local RS = game:GetService("RunService")
        
        -- [1] ESCUDO DEFLETOR (Stepped - Antes da física)
        table.insert(antiFlingV2Conns, RS.Stepped:Connect(function()
            local char = game.Players.LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if hrp then
                local overlap = OverlapParams.new()
                overlap.FilterType = Enum.RaycastFilterType.Exclude
                overlap.FilterDescendantsInstances = {char}
                
                local parts = workspace:GetPartBoundsInRadius(hrp.Position, 8, overlap)
                for _, part in ipairs(parts) do
                    if not part.Anchored and part:IsA("BasePart") then
                        local speed = part.AssemblyLinearVelocity.Magnitude
                        local rotSpeed = part.AssemblyAngularVelocity.Magnitude
                        
                        if speed > 30 or rotSpeed > 30 then
                            part.CanCollide = false 
                            part.AssemblyLinearVelocity = Vector3.new(0, -99999, 0)
                            part.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end
            end
        end))

        -- [2] MOTOR DE BACKUP (Heartbeat - Depois da física)
        table.insert(antiFlingV2Conns, RS.Heartbeat:Connect(function()
            local char = game.Players.LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                local myFlingActive = false
                pcall(function()
                    local touchKnob = GUI.TouchFling:FindFirstChild("ToggleBG") and GUI.TouchFling.ToggleBG:FindFirstChild("ToggleKnob")
                    local targetKnob = GUI.TargetFlingBtn:FindFirstChild("ToggleBG") and GUI.TargetFlingBtn.ToggleBG:FindFirstChild("ToggleKnob")
                    
                    if _G.FlingAuraEnabled then myFlingActive = true end
                    if touchKnob and touchKnob.Position.X.Offset > 10 then myFlingActive = true end
                    if targetKnob and targetKnob.Position.X.Offset > 10 then myFlingActive = true end
                    if _G.RemoteFlingData and _G.RemoteFlingData.ativo then myFlingActive = true end
                end)

                local speed = hrp.AssemblyLinearVelocity.Magnitude
                
                if speed > 150 and not myFlingActive then 
                    if lastSafeCFrame then
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.CFrame = lastSafeCFrame
                    end
                elseif speed < 40 and hum.FloorMaterial ~= Enum.Material.Air and not myFlingActive then
                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                    rayParams.FilterDescendantsInstances = {char}
                    
                    local result = workspace:Raycast(hrp.Position, Vector3.new(0, -6, 0), rayParams)
                    if result and result.Instance and result.Instance.Anchored then
                        lastSafeCFrame = hrp.CFrame
                    end
                end
            end
        end))
        
        if type(S7xNotify) == "function" then S7xNotify("ANTI FLING V2", "Deflector Shield & Bypass Active.") end
    else
        ClearAntiFlingV2()
        if type(S7xNotify) == "function" then S7xNotify("ANTI FLING V2", "System Offline.") end
    end
end

