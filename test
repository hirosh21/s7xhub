                pcall(function() curTrack:Destroy() end)
                pcall(function() resetFace(char) end)
                curTrack = nil
            end
            
            curMoodId = moodId
            local animId = getAnimId(moodId)
            local a = Instance.new("Animation")
            a.AnimationId = animId
            
            local t = anim:LoadAnimation(a)
            applyToTrack(t)
            curTrack = t
            t:Play() -- O Play puro igual ao seu código
            
            if not looped then
                t.Stopped:Connect(function()
                    if curTrack == t and curMoodId == moodId then
