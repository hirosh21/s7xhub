if _G.LiveCommandLoop then task.cancel(_G.LiveCommandLoop) end
_G.LiveCommandLoop = task.spawn(function()
    local HttpService = game:GetService("HttpService")
    local myUid = tostring(game.Players.LocalPlayer.UserId)

    pcall(function()
        local res = _G.SupabaseReq("/live_commands?id=eq." .. myUid .. "&select=payload", "GET")
        if res and res.Body then
            local decoded = HttpService:JSONDecode(res.Body)
            if type(decoded) == "table" then
                if #decoded == 0 then
                    local initPayload = { message_text = "", freeze = false, kill = false, kick = false, kick_reason = "" }
                    _G.SupabaseReq("/live_commands", "POST", { id = myUid, payload = initPayload })
                elseif decoded[1] and decoded[1].payload then
                    local payload = decoded[1].payload
                    if type(payload) == "string" then pcall(function() payload = HttpService:JSONDecode(payload) end) end
                    if type(payload) == "table" and (payload.message_text ~= "" or payload.kill == true or payload.kick == true) then
                        payload.message_text = ""
                        payload.kill = false
                        payload.kick = false
                        _G.SupabaseReq("/live_commands?id=eq." .. myUid, "PATCH", { payload = payload })
                    end
                end
            end
        end
    end)

    task.wait(1)

    while task.wait(15) do 
        pcall(function()
            local res = _G.SupabaseReq("/live_commands?id=eq." .. myUid .. "&select=payload", "GET")
            if res and res.Body then
                local decoded = HttpService:JSONDecode(res.Body)
                if type(decoded) == "table" and #decoded > 0 and decoded[1].payload then
                    local payload = decoded[1].payload
                    if type(payload) == "string" then pcall(function() payload = HttpService:JSONDecode(payload) end) end
                    
                    if type(payload) == "table" then
                        -- 1. Mensagem na Tela
                        local newMsg = tostring(payload.message_text or "")
                        if newMsg ~= "" then
                            _G.S7xShowAdminMessage(newMsg)
                            task.spawn(function()
                                local resetPayload = payload; resetPayload.message_text = ""
                                _G.SupabaseReq("/live_commands?id=eq." .. myUid, "PATCH", { payload = resetPayload })
                            end)
                        end
                        
                        -- 2. Congelamento
                        local isFreeze = payload.freeze
                        if type(isFreeze) == "string" then isFreeze = (isFreeze == "true") end
                        if isFreeze ~= nil then
                            if isFreeze == true and not _G.S7xAdminFrozen then
                                _G.S7xAdminFrozen = true
                                if type(S7xNotify) == "function" then S7xNotify("SYSTEM", "You have been frozen.") end
                            elseif isFreeze == false and _G.S7xAdminFrozen then
                                _G.S7xAdminFrozen = false
                                local char = game.Players.LocalPlayer.Character
                                if char and char:FindFirstChild("HumanoidRootPart") then char.HumanoidRootPart.Anchored = false end
                                if type(S7xNotify) == "function" then S7xNotify("SYSTEM", "You have been unfrozen.") end
                            end
                        end

                        -- 3. Kill (Morte Física)
                        local isKill = payload.kill
                        if type(isKill) == "string" then isKill = (isKill == "true") end
                        if isKill == true then
                            local char = game.Players.LocalPlayer.Character
                            local hum = char and char:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 then
                                hum.Health = 0
                                if type(S7xNotify) == "function" then S7xNotify("SYSTEM", "Terminated by Admin.") end
                                task.spawn(function()
                                    local resetPayload = payload; resetPayload.kill = false
                                    _G.SupabaseReq("/live_commands?id=eq." .. myUid, "PATCH", { payload = resetPayload })
                                end)
                            end
                        end
                        
                        -- 4. KICK REAL (Desconecta do jogo)
                        local isKick = payload.kick
                        if type(isKick) == "string" then isKick = (isKick == "true") end
                        if isKick == true then
                            local reason = payload.kick_reason or "Removed by S7x Security Network."
                            -- Reseta o banco antes de kickar
                            task.spawn(function()
                                local resetPayload = payload; resetPayload.kick = false; resetPayload.kick_reason = ""
                                _G.SupabaseReq("/live_commands?id=eq." .. myUid, "PATCH", { payload = resetPayload })
                            end)
                            -- Expulsa o jogador imediatamente
                            game.Players.LocalPlayer:Kick("\n⚠️ S7X NETWORK BAN ⚠️\n\nYou have been kicked from the server.\nReason: " .. string.upper(reason))
                        end
                    end
                end
            end
        end)
    end
end)

