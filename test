                TargetLabel.Text = "Nenhum alvo selecionado"
                TargetLabel.TextColor3 = Color3.fromRGB(100, 100, 100)
                targetPlayer = nil
                isAttacking = false
                ToggleButton.Text = "INICIAR SEED ATTACK"
                ToggleButton.BackgroundColor3 = Color3.fromRGB(140, 0, 255)
            end
        end

