local function PlayTpEffect(pos)
    task.spawn(function()
        -- 1. Âncora Física (Necessária para o Áudio e Partículas)
        local anchor = Instance.new("Part")
        anchor.Transparency = 1
        anchor.Anchored = true
        anchor.CanCollide = false
        anchor.Size = Vector3.new(0.1, 0.1, 0.1)
        anchor.CFrame = CFrame.new(pos)
        anchor.Parent = workspace 
        
        -- 2. ÁUDIO 3D PROFISSIONAL (Volume 50% e Física de Distância)
        local sfx = Instance.new("Sound")
        sfx.SoundId = "rbxassetid://138819213201245"
        sfx.Volume = 0.5 
        sfx.RollOffMode = Enum.RollOffMode.Linear 
        sfx.RollOffMinDistance = 15 
        sfx.RollOffMaxDistance = 100 
        sfx.Parent = anchor 
        sfx:Play()
        
        -- 3. GERENCIADOR DE CAMADAS VFX (As 3 texturas que você pegou)
        local att = Instance.new("Attachment", anchor)
        
        -- Função auxiliar para criar as partículas com padrão visual S7x
        local function createLayer(textureId, sizeSeq, speed, emitCount, extraSetup)
            local pe = Instance.new("ParticleEmitter", att)
            pe.Texture = textureId
            pe.Color = ColorSequence.new(Color3.fromRGB(170, 0, 255)) -- Roxa para combinar com o seu layout Black-Out
            pe.LightEmission = 1 
            pe.LightInfluence = 0
            pe.ZOffset = 10 
            pe.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
            pe.Size = sizeSeq
            pe.Speed = speed
            pe.Lifetime = NumberRange.new(0.4, 0.7)
            pe.EmissionDirection = Enum.NormalId.Top
            pe.Drag = 4
            pe.Enabled = false
            
            if extraSetup then extraSetup(pe) end
            pe:Emit(emitCount)
        end

        -- CAMADA 1: Sparks (Faíscas - Explodem para todos os lados)
        createLayer("rbxassetid://6660412891", 
            NumberSequence.new({NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 0)}), 
            NumberRange.new(20, 35), 40, 
            function(p) p.SpreadAngle = Vector2.new(360, 360) end
        )

        -- CAMADA 2: Wave1 (Anéis de luz - Menos quantidade, mas crescem rápido)
        createLayer("rbxassetid://8047533775", 
            NumberSequence.new({NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 15)}), 
            NumberRange.new(5, 10), 10,
            function(p) 
                p.SpreadAngle = Vector2.new(360, 360)
                p.Orientation = Enum.ParticleOrientation.VelocityParallel -- Dá o efeito de corte no ar
            end
        )

        -- CAMADA 3: Wave2 (Pilar de Luz - Sobe reto e se dissipa)
        createLayer("rbxassetid://8047796070", 
            NumberSequence.new({NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 0)}), 
            NumberRange.new(15, 25), 15,
            function(p) p.SpreadAngle = Vector2.new(0, 0) end -- 0 de spread faz o pilar subir perfeitamente reto
        )
        
        -- Destrói a âncora após 3 segundos
        game:GetService("Debris"):AddItem(anchor, 3)
    end)
end

