                rank = GetFirebaseRank(player) or "User" 
            end
            
            -- [ 1. LÓGICA DA ABA ADMIN ] (Apenas Alta Cúpula)
            local canSeeAdmin = { 
                ["Supervisor"] = true, ["Co-Owner"] = true, 
                ["Owner"] = true, ["Creator"] = true 
            }
            if GUI.AdminTabBtn then 
                GUI.AdminTabBtn.Visible = canSeeAdmin[rank] or false 
            end
            
            -- [ 2. LÓGICA DA ABA TAG EDIT ] (Staffs e VIPs Ultimate/Supreme)
            local canSeeTagEdit = {
                ["Contributor"]=true, ["Marketing"]=true, ["Helper"]=true, 
                ["Supervisor"]=true, ["Owner"]=true, ["Co-Owner"]=true, 
                ["Manager"]=true, ["Creator"]=true, ["Supreme"]=true, 
                ["Developer"]=true, ["Dev"]=true, ["Ultimate"]=true, ["Influencer"]=true
            }
            
            local hasTagAccess = canSeeTagEdit[rank] or false
            
            -- Se não for staff por cargo, verifica se ele ativou uma Ultimate Key
            if not hasTagAccess and type(_G.hasUltimateAccess) == "function" then
