    local function resolveAnimationMappings(bundledItems)
        local mappings = {}
        if type(bundledItems) ~= "table" then return mappings end
        for _, assetIds in pairs(bundledItems) do
            for _, assetId in pairs(assetIds) do
                local success, objects = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(assetId)) end)
                if success and objects then
                    local function searchTree(parent, parentPath)
                        for _, child in pairs(parent:GetChildren()) do
                            if child:IsA("Animation") then
                                local pathParts = string.split(parentPath .. "." .. child.Name, ".")
                                local weightVals = {}
                                for _, wChild in ipairs(child:GetChildren()) do
                                    if wChild:IsA("NumberValue") and wChild.Name == "Weight" then table.insert(weightVals, wChild.Value) end
                                end
                                table.insert(mappings, { category = pathParts[#pathParts - 1], name = pathParts[#pathParts], animationId = child.AnimationId, weights = weightVals })
                            elseif #child:GetChildren() > 0 then
                                searchTree(child, parentPath .. "." .. child.Name)
                            end
                        end
                    end
                    for _, obj in pairs(objects) do
                        searchTree(obj, obj.Name)
                        obj.Parent = workspace
                        task.delay(1, function() if obj then obj:Destroy() end end)
                    end
                end
            end
        end
        return mappings
    end

    _G.S7xApplyAnimations = function(animationData)
        task.spawn(function()
            local char = player.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local animate = char and char:FindFirstChild("Animate")
            if not hum or not animate then return end
            if hum.RigType == Enum.HumanoidRigType.R6 then if type(S7xNotify) == "function" then S7xNotify("ERROR", "Requeres R15 body!") end return end
            _G.S7xCurrentAnimData = animationData
            local bundledItems = animationData.bundledItems
            for _, track in pairs(hum:GetPlayingAnimationTracks()) do track:Stop() end
            local mappings = resolveAnimationMappings(bundledItems)
            if #mappings == 0 then return end
            local sorted = {}
            for _, m in ipairs(mappings) do if string.lower(m.category) == "idle" then table.insert(sorted, 1, m) else table.insert(sorted, m) end end
            local function applyAnimToObject(animObj, animId, weights)
                if not animObj or not animObj:IsA("Animation") then return end
                animObj.AnimationId = animId
                if weights ~= nil then
                    for _, child in ipairs(animObj:GetChildren()) do if child:IsA("NumberValue") and child.Name == "Weight" then child:Destroy() end end
                    for _, wVal in ipairs(weights) do local w = Instance.new("NumberValue"); w.Name = "Weight"; w.Value = wVal; w.Parent = animObj end
                end
            end
            local mappingMap = {}
            for _, m in ipairs(sorted) do
                local cat = string.lower(m.category)
                if not mappingMap[cat] then mappingMap[cat] = { folderName = m.category, items = {} } end
                mappingMap[cat].items[string.lower(m.name)] = m
            end
            animate.Disabled = true
            for cat, data in pairs(mappingMap) do
                local categoryFolder = animate:FindFirstChild(data.folderName)
                if categoryFolder then
                    local sourceByName = {}
                    for name, m in pairs(data.items) do sourceByName[name] = m end
                    for _, animObj in ipairs(categoryFolder:GetChildren()) do
                        if animObj:IsA("Animation") then
                            local lowerName = string.lower(animObj.Name)
                            local m = sourceByName[lowerName]
                            if m then sourceByName[lowerName] = nil; applyAnimToObject(animObj, m.animationId, m.weights); animObj.Name = m.name else animObj:Destroy() end
                        end
                    end
                    for _, m in pairs(sourceByName) do
                        local animObj = Instance.new("Animation"); animObj.Name = m.name; applyAnimToObject(animObj, m.animationId, m.weights); animObj.Parent = categoryFolder
                    end
                end
            end
            if hum.MoveDirection.Magnitude == 0 then animate.Disabled = false end
            if type(S7xNotify) == "function" then S7xNotify("SYNC", string.upper(animationData.name) .. " APPLIED!") end
        end)
    end

