                local sessionTime = now - _G.S7xSessionStart
                local h = math.floor(sessionTime / 3600)
                local m = math.floor((sessionTime % 3600) / 60)
                local s = math.floor(sessionTime % 60)
                GUI.SessionLabel.Text = string.format("TIME: %02d:%02d:%02d", h, m, s)
                
                frames = 0; lastUpdate = now
            end
        end
    end)
