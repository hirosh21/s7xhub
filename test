-- [ VERIFICAÇÃO PROFISSIONAL DE UNC / HOOKS ]
local executorSupported = (hookmetamethod ~= nil and getnamecallmethod ~= nil and checkcaller ~= nil and newcclosure ~= nil)

task.spawn(function()
    if _G.VCHooked_V16 then return end
    _G.VCHooked_V16 = true

    if not executorSupported then return end 

    local blockedMethods = {
        "reportuser", "reportabuse", "reportabusev3", "sendvoiceanalytics", 
        "sendrobloxtelemetry", "sendeventtoserver", "report", "submitreport", 
        "capturescreenshot", "publishanalyticsevent", "eventingest", "postreport", 
        "reportvoiceabuse", "submitvoiceabuse", "recordvoice"
    }

    local blockedServices = {
        ["VoiceChatInternal"] = true,
        ["AnalyticsService"] = true,
        ["RobloxTelemetryService"] = true,
        ["HttpRbxApiService"] = true
    }

    pcall(function()
        -- [ 1. HOOK DE COMUNICAÇÃO (NAMECALL) - PROTEÇÃO ABSOLUTA ]
        local old_namecall
        old_namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if _G.S7xVCMode == "OFF" then return old_namecall(self, ...) end

            if not checkcaller() then
                local method = string.lower(tostring(getnamecallmethod()))
                local selfName = string.lower(tostring(self))
                local successClass, className = pcall(function() return self.ClassName end)
                local sClass = successClass and className or ""

                -- Modo Manual: Apenas permite limpar o cache
                if _G.S7xVCMode == "MANUAL" and _G.VoiceCacheCleared then
                    return old_namecall(self, ...)
                end

                -- Se for SUPER AUTO e o mic estiver aberto, blindagem máxima
                if _G.S7xVCMode == "SUPER AUTO" then
                    if blockedServices[sClass] then
                        if string.find(method, "report") or string.find(method, "abuse") or string.find(method, "analytics") then
                            return -- Destrói a requisição silenciosamente
                        end
                    end
                    
                    if method == "fireserver" or method == "invokeserver" or method == "postasync" then
                        for _, blocked in ipairs(blockedMethods) do
                            if string.find(selfName, blocked) or string.find(method, blocked) then
                                return -- Anula pacotes de telemetria e denúncia de voz
                            end
                        end
                    end
                end

                -- MODO AUTOMATIC / SUPER (Legado)
                if _G.S7xVCMode == "AUTOMATIC" or _G.S7xVCMode == "SUPER" then
                    if blockedServices[sClass] then
                        if string.find(method, "report") or string.find(method, "abuse") or string.find(method, "analytics") then return end
                    end
                    if method == "fireserver" or method == "invokeserver" or method == "postasync" then
                        for _, blocked in ipairs(blockedMethods) do
                            if string.find(selfName, blocked) or string.find(method, blocked) then return end
                        end
                    end
                end
            end
            return old_namecall(self, ...)
        end))

        -- [ 2. HOOK DE LEITURA (INDEX) ]
        local old_index
        old_index = hookmetamethod(game, "__index", newcclosure(function(self, index)
            if not checkcaller() and (_G.S7xVCMode == "SUPER" or _G.S7xVCMode == "SUPER AUTO") then
                local sName = tostring(self)
                local iName = tostring(index)
                
                -- Engana o sistema do Roblox dizendo que não está gravando (mesmo estando)
                if sName == "VoiceChatService" and (iName == "IsRecording" or iName == "IsPublishing") then
                    return false 
                end
            end
            return old_index(self, index)
        end))
    end)

    -- Destruidor de Bolhas de Denúncia Visuais
    local function cleanVoiceBubbles(char)
        if not char then return end
        local head = char:WaitForChild("Head", 5)
        if head then
            head.ChildAdded:Connect(function(child)
                if (_G.S7xVCMode == "SUPER" or _G.S7xVCMode == "SUPER AUTO") and (string.find(child.Name, "VoiceChat") or string.find(child.Name, "Report")) then
                    task.defer(function() pcall(function() child:Destroy() end) end)
                end
            end)
        end
    end

    if game.Players.LocalPlayer.Character then cleanVoiceBubbles(game.Players.LocalPlayer.Character) end
    game.Players.LocalPlayer.CharacterAdded:Connect(cleanVoiceBubbles)
end)

