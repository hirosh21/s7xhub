_G.TagRenderConnection = game:GetService("RunService").RenderStepped:Connect(function()
    if not _G.S7xTagVisible then return end
    
    local t = tick()
    local metallicOffset = (t * 0.7) % 2 - 1
    local pulseSin = (math.sin(t * 3.5) + 1) / 2 
    local fireOffset = (math.sin(t * 6) * 0.15)

    for userId, data in pairs(SpecialTags) do
        local head = data.Head
        if not head or not head.Parent or not head:IsDescendantOf(workspace) or (head.Parent:FindFirstChild("Humanoid") and head.Parent.Humanoid.Health <= 0) then
            pcall(function() if data.Label and data.Label.Parent then data.Label.Parent:Destroy() end end)
            SpecialTags[userId] = nil
            continue
        end
        
        local lbl = data.Label
        local rank = data.Rank
        local grad = lbl:FindFirstChild("ShineGradient") or Instance.new("UIGradient", lbl)

        pcall(function()
            -- Busca a configuração customizada do jogador
            local customConf = nil
            if rank == "Custom" then
                customConf = _G.CustomTagsConfig and _G.CustomTagsConfig[tostring(userId)]
            else
                customConf = _G.CustomTagsConfig and _G.CustomTagsConfig[rank]
            end
            
            -- LÓGICA DE EFEITOS DINÂMICOS COM 5 CORES
            if customConf then
                -- Extrai as 5 camadas de cor da Customização do Jogador
                local c1 = _G.S7xParseColor(customConf.Color1 or customConf.Color, Color3.fromRGB(255, 255, 255))
                local c2 = _G.S7xParseColor(customConf.Color2, Color3.fromRGB(200, 200, 200))
                local c3 = _G.S7xParseColor(customConf.Color3, Color3.fromRGB(150, 150, 150))
                local c4 = _G.S7xParseColor(customConf.Color4, Color3.fromRGB(100, 100, 100))
                local c5 = _G.S7xParseColor(customConf.Color5, Color3.fromRGB(50, 50, 50))
                
                local cStroke = _G.S7xParseColor(customConf.StrokeColor, Color3.fromRGB(0, 0, 0))
                local transpStroke = tonumber(customConf.StrokeTransparency) or 0
                local effect = customConf.Effect or "Solid"

                lbl.TextStrokeColor3 = cStroke
                lbl.TextStrokeTransparency = transpStroke

                -- O SEGREDO PROFISSIONAL: Cada efeito agora usa as Cores (C1 até C5) mapeadas
                if effect == "Metallic" or effect == "Metalico" then
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, c1),
                        ColorSequenceKeypoint.new(0.40, c1),
                        ColorSequenceKeypoint.new(0.5, c2), -- Brilho Metálico
                        ColorSequenceKeypoint.new(0.60, c1),
                        ColorSequenceKeypoint.new(1, c1)
                    })
                    grad.Offset = Vector2.new(metallicOffset, 0)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)

                elseif effect == "Duo-chrome" then
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, c1),
                        ColorSequenceKeypoint.new(0.5, c2),
                        ColorSequenceKeypoint.new(1, c3)
                    })
                    grad.Offset = Vector2.new(metallicOffset * 0.8, 0)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)

                elseif effect == "Rainbow" or effect == "Chroma" then
                    -- Usa as 5 cores para formar uma onda Chroma personalizada
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, c1),
                        ColorSequenceKeypoint.new(0.25, c2),
                        ColorSequenceKeypoint.new(0.5, c3),
                        ColorSequenceKeypoint.new(0.75, c4),
                        ColorSequenceKeypoint.new(1, c5)
                    })
                    grad.Offset = Vector2.new(metallicOffset, 0)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)

                elseif effect == "Neon Pulse" then
                    -- Pulsa intensamente entre a Cor 1 e a Cor 2
                    local lerpedColor = c1:Lerp(c2, pulseSin * 0.6)
                    grad.Color = ColorSequence.new(lerpedColor)
                    grad.Offset = Vector2.new(0, 0)
                    lbl.TextColor3 = lerpedColor

                elseif effect == "Cosmic" then
                    -- Mapeia C1 a C5 na estrutura de uma Galáxia
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, c1),
                        ColorSequenceKeypoint.new(0.35, c2),
                        ColorSequenceKeypoint.new(0.5, c3),
                        ColorSequenceKeypoint.new(0.75, c4),
                        ColorSequenceKeypoint.new(1, c5)
                    })
                    grad.Offset = Vector2.new(metallicOffset * 0.9, 0)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)

                elseif effect == "Fire" then
                    -- As chamas usam C1 (Base), C2 e C3 (Meio) e C4 (Topo)
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, c1),
                        ColorSequenceKeypoint.new(0.45, c2),
                        ColorSequenceKeypoint.new(0.7, c3),
                        ColorSequenceKeypoint.new(1, c4)
                    })
                    grad.Offset = Vector2.new(fireOffset, 0)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)

                elseif effect == "Gold Luxury" then
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, c1),
                        ColorSequenceKeypoint.new(0.4, c2),
                        ColorSequenceKeypoint.new(0.5, c3), -- Brilho Central Diamante
                        ColorSequenceKeypoint.new(0.6, c2),
                        ColorSequenceKeypoint.new(1, c1)
                    })
                    grad.Offset = Vector2.new(metallicOffset * 1.1, 0)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)

                else
                    grad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
                    grad.Offset = Vector2.new(0, 0)
                    lbl.TextColor3 = c1
                end
                
            -- ==========================================
            -- CORES ORIGINAIS DAS ROLES DO SISTEMA
            -- ==========================================
            else
                local function ApplyMetallicRole(baseColor)
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, baseColor),
                        ColorSequenceKeypoint.new(0.40, baseColor),
                        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
                        ColorSequenceKeypoint.new(0.60, baseColor),
                        ColorSequenceKeypoint.new(1, baseColor)
                    })
                    grad.Offset = Vector2.new(metallicOffset, 0)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                end
                
                local function ApplySolidRole(color)
                    grad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
                    grad.Offset = Vector2.new(0, 0)
                    lbl.TextColor3 = color
                end

                if rank == "Owner" then
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(210, 210, 210)),
                        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 60, 60))
                    })
                    grad.Offset = Vector2.new(metallicOffset * 0.7, 0)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    lbl.TextStrokeTransparency = 0
                elseif rank == "Co-Owner" then ApplyMetallicRole(Color3.fromRGB(90, 50, 20)); lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0
                elseif rank == "Supreme" then ApplyMetallicRole(Color3.fromRGB(0, 20, 100)); lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0
                elseif rank == "Contributor" then ApplyMetallicRole(Color3.fromRGB(255, 85, 0)); lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0
                elseif rank == "Friends" then ApplyMetallicRole(Color3.fromRGB(173, 216, 230)); lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0
                elseif rank == "Helper" then ApplyMetallicRole(Color3.fromRGB(255, 200, 0)); lbl.TextStrokeColor3 = Color3.fromRGB(255, 255, 255); lbl.TextStrokeTransparency = 0   
                elseif rank == "Supervisor" then ApplyMetallicRole(Color3.fromRGB(60, 0, 90)); lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0
                elseif rank == "Manager" then ApplyMetallicRole(Color3.fromRGB(120, 0, 0)); lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0
                elseif rank == "Developer" then ApplyMetallicRole(Color3.fromRGB(180, 140, 0)); lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0
                elseif rank == "Marketing" then ApplyMetallicRole(Color3.fromRGB(0, 80, 0)); lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0
                elseif rank == "Influencer" then ApplyMetallicRole(Color3.fromRGB(216, 175, 255)); lbl.TextStrokeColor3 = Color3.fromRGB(255, 20, 147); lbl.TextStrokeTransparency = 0
                elseif rank == "Designer" then ApplySolidRole(Color3.fromRGB(0, 100, 255)); lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0.2
                elseif rank == "Tester" then ApplySolidRole(Color3.fromRGB(139, 69, 19)); lbl.TextStrokeColor3 = Color3.fromRGB(255, 255, 255); lbl.TextStrokeTransparency = 0
                elseif rank == "User" then ApplySolidRole(Color3.fromRGB(210, 210, 215)); lbl.TextStrokeColor3 = Color3.fromRGB(30, 30, 35); lbl.TextStrokeTransparency = 0.2
                else ApplySolidRole(Color3.fromRGB(255, 255, 255)); lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0
                end
            end
        end)
    end
end)


