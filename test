        local tUp = TweenInfo.new(0.3, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out)

        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                pcall(function() ts:Create(uiScale, tDown, {Scale = 0.92}):Play() end)
            end
        end)

        btn.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                pcall(function() ts:Create(uiScale, tUp, {Scale = 1}):Play() end)
            end
        end)

        btn.MouseLeave:Connect(function()
            pcall(function() ts:Create(uiScale, tUp, {Scale = 1}):Play() end)
        end)

        btn.MouseButton1Click:Connect(function()
            pcall(function()
                local isTabButton = btn.Parent and (btn.Parent.Name == "TabMenu" or btn.Parent.Name == "ScrollingFrame" and btn.Parent.Parent == GUI.MainFrame)
                if isTabButton then tabSFX:Play() else clickSFX:Play() end
            end)
        end)
    end

    -- Aplica os efeitos a todas as UIs geradas
    if GUI and GUI.ScreenGui then
        for _, element in ipairs(GUI.ScreenGui:GetDescendants()) do
            bindButtonEffects(element)
        end

        GUI.ScreenGui.DescendantAdded:Connect(function(element)
            bindButtonEffects(element)
        end)
    end
end)

