    _G.AntiStunEnabled = false
    local antiStunConn = nil

    GUI.AntiStunBtn.MouseButton1Click:Connect(function()
        _G.AntiStunEnabled = not _G.AntiStunEnabled
        if type(setToggleState) == "function" then setToggleState(GUI.AntiStunBtn, _G.AntiStunEnabled) end

        if _G.AntiStunEnabled then
            if antiStunConn then antiStunConn:Disconnect() end
            
            -- Usamos Stepped para atropelar a engine do Roblox ANTES da simulação física
            antiStunConn = RS.Stepped:Connect(function()
                local char = player.Character
                if char then
                    local hum = char:FindFirstChild("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")

                    if hum then
                        -- 1. Previne lentidão extrema ou paralisia (Força o mínimo de 16 de velocidade)
                        if hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end
                        
                        -- 2. Restaura capacidade de pular (Trata ambos os sistemas antigos e novos do Roblox)
                        if hum.UseJumpPower and hum.JumpPower < 50 then hum.JumpPower = 50 end
                        if not hum.UseJumpPower and hum.JumpHeight < 7.2 then hum.JumpHeight = 7.2 end
                        
                        -- 3. Quebra estados de Stun induzidos por animação ou scripts de combate
                        if hum.PlatformStand then hum.PlatformStand = false end
                        if hum.Sit then hum.Sit = false end
                        
                        -- 4. Força o personagem a levantar se o jogo tentar travá-lo no chão
                        local state = hum:GetState()
                        if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.Seated or state == Enum.HumanoidStateType.Ragdoll then
                            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                        end
                    end

                    -- 5. Solta o jogador se o dev do mapa usar Anchored para prender
                    if hrp and hrp.Anchored then
                        -- Não desancora se o jogador ativou ferramentas do Hub que precisam do anchor (Ex: FakeLag, Freecam)
                        if not _G.FakeLagEnabled and not _G.S7xFreecamEnabled then
                            hrp.Anchored = false
                        end
                    end
                end
            end)
            if type(S7xNotify) == "function" then S7xNotify("ANTI STUN", "Combat restrictions bypassed.") end
        else
            if antiStunConn then antiStunConn:Disconnect(); antiStunConn = nil end
            if type(S7xNotify) == "function" then S7xNotify("ANTI STUN", "System disabled.") end
        end
    end)

