local function setToggleState(btn, isEnabled)
    local bg = btn:FindFirstChild("ToggleBG")
    local knob = bg and bg:FindFirstChild("ToggleKnob")
    local strk = btn:FindFirstChildOfClass("UIStroke")
    local bgStrk = bg and bg:FindFirstChildOfClass("UIStroke")
    local lbl = btn:FindFirstChild("Title")
    
    if type(PlayToggleSound) == "function" then PlayToggleSound(isEnabled) end
    
    if bg and knob then
        if isEnabled then
            if SafeTween then
                SafeTween(bg, 0.4, {BackgroundColor3 = Color3.fromRGB(140, 0, 255)})
                SafeTween(bgStrk, 0.4, {Color = Color3.fromRGB(180, 50, 255)})
                SafeTween(knob, 0.4, {Position = UDim2.new(1, -12, 0.5, -5), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}, Enum.EasingStyle.Back)
                SafeTween(btn, 0.4, {BackgroundColor3 = Color3.fromRGB(12, 5, 20)}) -- Leve brilho roxo quando ON
                if strk then SafeTween(strk, 0.3, {Color = Color3.fromRGB(140, 0, 255), Thickness = 1.5}) end
                if lbl then SafeTween(lbl, 0.3, {TextColor3 = Color3.fromRGB(255, 255, 255)}) end
            end
        else
            if SafeTween then
                SafeTween(bg, 0.3, {BackgroundColor3 = Color3.fromRGB(20, 20, 25)})
                SafeTween(bgStrk, 0.3, {Color = Color3.fromRGB(45, 45, 50)})
                SafeTween(knob, 0.3, {Position = UDim2.new(0, 2, 0.5, -5), BackgroundColor3 = Color3.fromRGB(100, 100, 110)}, Enum.EasingStyle.Back)
                SafeTween(btn, 0.3, {BackgroundColor3 = Color3.fromRGB(0, 0, 0)}) -- PRETO ABSOLUTO quando OFF
                if strk then SafeTween(strk, 0.3, {Color = Color3.fromRGB(35, 35, 40), Thickness = 1.2}) end
                if lbl then SafeTween(lbl, 0.3, {TextColor3 = Color3.fromRGB(150, 150, 160)}) end
            end
        end
    end
end

