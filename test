SendP2PPing = function()
    pcall(function()
        local char = game.Players.LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        local animator = hum and hum:FindFirstChild("Animator")
        
        if animator then
            local targetId = hum.RigType == Enum.HumanoidRigType.R6 and SIGNAL_ID_R6 or SIGNAL_ID_R15
            local syncAnim = Instance.new("Animation")
