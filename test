        else
            alvoPosicao = mouse.Hit.Position + Vector3.new(0, 2, 0)
            -- Se o alvo morreu, quitou ou perdeu o HumanoidRootPart, destrava automaticamente!
            if _G.RemoteFlingData.alvo then 
                _G.TogglePTarget()
            end 
        end

        for _, peca in ipairs(partesParaMover) do
