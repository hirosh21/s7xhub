        local function createSlider(name, min, max, default)
            Settings[name] = default or min
            local bg = Instance.new("Frame", scrollFrame)
            bg.Size = UDim2.new(1, -10, 0, 45)
            bg.BackgroundColor3 = Color3.fromRGB(20, 18, 25)
