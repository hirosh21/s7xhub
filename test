            track.Priority = Enum.AnimationPriority.Core
            -- Toca invisível por 0.1s só para disparar a rede instantaneamente para os outros
            track:Play(0, 0.0001, 0)
            task.delay(0.2, function() track:Stop() end)
        end
    end)
end

