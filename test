local function GetExactSessionTime(plr)
    local joinTime = _G.S7xSessionTracker[plr.UserId] or os.time()
    local sessionTotal = os.time() - joinTime
    local sHours = math.floor(sessionTotal / 3600)
    local sMins = math.floor((sessionTotal % 3600) / 60)
    local sSecs = sessionTotal % 60
    return string.format("%02dh %02dm %02ds", sHours, sMins, sSecs)
end

-- NOVO: BUSCADOR INTELIGENTE DE HORAS NO BANCO DE DADOS (LEADERSTATS)
local function GetDatabaseTime(plr)
    local timeStr = nil
    pcall(function()
        local ls = plr:FindFirstChild("leaderstats")
        if ls then
            -- Nomes comuns de banco de dados para tempo em jogos
            local timeNames = {"Time", "Minutes", "Minutos", "Hours", "Horas", "Tempo", "TimePlayed", "PlayTime", "Mins"}
            for _, statName in ipairs(timeNames) do
                local stat = ls:FindFirstChild(statName)
                if stat then
                    local val = tonumber(stat.Value)
                    if val then
                        if val >= 1000 then
                            -- Formata valores altos (ex: 11.33k MIN)
                            timeStr = string.format("%.2fK %s", val / 1000, statName:sub(1,3):upper())
                        else
                            timeStr = tostring(val) .. " " .. statName:sub(1,3):upper()
                        end
                        break
                    end
                end
            end
        end
    end)
    -- Se o jogo não tiver um banco de horas no leaderstats, ele volta para o tempo da sessão exata
    return timeStr or GetExactSessionTime(plr)
end

