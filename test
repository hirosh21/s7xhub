-- [ 3. SINCRONIZADOR GLOBAL DO SERVIDOR ]
SyncServerPresence = function()
    if not _G.S7xTagVisible then return end
    task.spawn(function()
        pcall(function()
            local res = _G.SupabaseReq("/presence?select=id,payload", "GET")
            if res and res.Body then
                local decoded = game:GetService("HttpService"):JSONDecode(res.Body)
                if type(decoded) == "table" and not decoded.error then
                    local currentTime = os.time()
                    for _, row in ipairs(decoded) do
                        local payload = row.payload
                        if type(payload) == "string" then pcall(function() payload = game:GetService("HttpService"):JSONDecode(payload) end) end
                        
                        if type(payload) == "table" and payload.job_id == tostring(game.JobId) then
                            local uid = tonumber(row.id)
                            -- Aceita sinais dos últimos 35 segundos
                            if uid and uid ~= game.Players.LocalPlayer.UserId and payload.Time and (currentTime - payload.Time <= 35) then
                                local targetPlr = game:GetService("Players"):GetPlayerByUserId(uid)
                                if targetPlr then
                                    _G.PresenceTags[uid] = payload.Tag 
                                    _G.PresenceAuras[uid] = payload.Aura 
                                    
                                    if not _G.S7xUsers[uid] then
                                        _G.S7xUsers[uid] = true
                                        if type(NotifySignalReceived) == "function" then task.spawn(NotifySignalReceived, targetPlr) end
                                    end
                                    
                                    task.spawn(function()
                                        if ApplyOrUpdateTag then ApplyOrUpdateTag(targetPlr) end
                                        if ApplyS7xAura then ApplyS7xAura(targetPlr) end
                                    end)
                                end
                            elseif uid and _G.S7xUsers[uid] then
                                -- Limpa quem saiu ou desligou a tag
                                _G.S7xUsers[uid] = nil; _G.PresenceTags[uid] = nil; _G.PresenceAuras[uid] = nil
                                if SpecialTags[uid] then pcall(function() SpecialTags[uid].Label.Parent:Destroy() end); SpecialTags[uid] = nil end
                            end
                        end
                    end
                end
            end
        end)
    end)
end

