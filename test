            nameLbl.TextStrokeTransparency = 0
            
            if entry.Effect and entry.Effect ~= "Solid" then
                local grad = Instance.new("UIGradient", nameLbl)
                local cc1 = _G.S7xParseColor(entry.Color1, Color3.fromRGB(255,255,255))
                local cc2 = _G.S7xParseColor(entry.Color2, Color3.fromRGB(200,200,200))
                local cc3 = _G.S7xParseColor(entry.Color3, Color3.fromRGB(150,150,150))
                local cc4 = _G.S7xParseColor(entry.Color4, Color3.fromRGB(100,100,100))
                local cc5 = _G.S7xParseColor(entry.Color5, Color3.fromRGB(50,50,50))
                
                if entry.Effect == "Duo-chrome" then
                    grad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, cc1), ColorSequenceKeypoint.new(0.5, cc2), ColorSequenceKeypoint.new(1, cc3)})
                elseif entry.Effect == "Rainbow" then
                    grad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, cc1), ColorSequenceKeypoint.new(0.25, cc2), ColorSequenceKeypoint.new(0.5, cc3), ColorSequenceKeypoint.new(0.75, cc4), ColorSequenceKeypoint.new(1, cc5)})
                elseif entry.Effect == "Fire" then
                    grad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, cc1), ColorSequenceKeypoint.new(0.45, cc2), ColorSequenceKeypoint.new(0.7, cc3), ColorSequenceKeypoint.new(1, cc4)})
                elseif entry.Effect == "Cosmic" then
                    grad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, cc1), ColorSequenceKeypoint.new(0.35, cc2), ColorSequenceKeypoint.new(0.5, cc3), ColorSequenceKeypoint.new(0.75, cc4), ColorSequenceKeypoint.new(1, cc5)})
                elseif entry.Effect == "Gold Luxury" then
                    grad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, cc1), ColorSequenceKeypoint.new(0.4, cc2), ColorSequenceKeypoint.new(0.5, cc3), ColorSequenceKeypoint.new(0.6, cc2), ColorSequenceKeypoint.new(1, cc1)})
                elseif entry.Effect == "Metallic" then
                    grad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, cc1), ColorSequenceKeypoint.new(0.4, cc1), ColorSequenceKeypoint.new(0.5, cc2), ColorSequenceKeypoint.new(0.6, cc1), ColorSequenceKeypoint.new(1, cc1)})
                else
                    grad.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, cc1), ColorSequenceKeypoint.new(1, cc2)})
                end
                nameLbl.TextColor3 = Color3.fromRGB(255,255,255)
            end
            
            local restoreBtn = Instance.new("TextButton", row)
            restoreBtn.Size = UDim2.new(0, 75, 0, 26)
            restoreBtn.Position = UDim2.new(1, -85, 0.5, -13)
            restoreBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
            restoreBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            restoreBtn.Font = Enum.Font.GothamBold
            restoreBtn.TextSize = 10
            restoreBtn.Text = "RESTORE"
            restoreBtn.AutoButtonColor = false
            Instance.new("UICorner", restoreBtn).CornerRadius = UDim.new(0, 4)
            local rStrk = Instance.new("UIStroke", restoreBtn)
            rStrk.Color = Color3.fromRGB(60, 60, 70)
            
            restoreBtn.MouseEnter:Connect(function() pcall(function() ts:Create(restoreBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(170, 0, 255)}):Play(); ts:Create(rStrk, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 255, 255)}):Play() end) end)
            restoreBtn.MouseLeave:Connect(function() pcall(function() ts:Create(restoreBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 30)}):Play(); ts:Create(rStrk, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 60, 70)}):Play() end) end)
            
            restoreBtn.MouseButton1Click:Connect(function()
                NameInput.Text = entry.Name
                currentEffect = entry.Effect or "Solid"
                currentFont = entry.Font or "GothamBlack"
                cColor1 = entry.Color1 or "#FFFFFF"
                cColor2 = entry.Color2 or "#00E5FF"
                cColor3 = entry.Color3 or "#FF00FF"
                cColor4 = entry.Color4 or "#FFFF00"
                cColor5 = entry.Color5 or "#FF0000"
                currentStroke = entry.Stroke or "#000000"
                
                c1Lbl.Text = cColor1; c1Btn.BackgroundColor3 = _G.S7xParseColor(cColor1, Color3.fromRGB(255,255,255))
                c2Lbl.Text = cColor2; c2Btn.BackgroundColor3 = _G.S7xParseColor(cColor2, Color3.fromRGB(0,229,255))
                c3Lbl.Text = cColor3; c3Btn.BackgroundColor3 = _G.S7xParseColor(cColor3, Color3.fromRGB(255,0,255))
                c4Lbl.Text = cColor4; c4Btn.BackgroundColor3 = _G.S7xParseColor(cColor4, Color3.fromRGB(255,255,0))
                c5Lbl.Text = cColor5; c5Btn.BackgroundColor3 = _G.S7xParseColor(cColor5, Color3.fromRGB(255,0,0))
                strkLbl.Text = currentStroke; strkBtn.BackgroundColor3 = _G.S7xParseColor(currentStroke, Color3.fromRGB(0,0,0))
                
                refreshGridSelections()
                UpdateRealTimePreview()
                
                if type(S7xNotify) == "function" then S7xNotify("TAG RESTORED", "Configurações restauradas com sucesso.") end
            end)
        end
        HistoryList.CanvasSize = UDim2.new(0, 0, 0, #tagHistory * 46)
        
        local contentHeight = layout.AbsoluteContentSize.Y
        if contentHeight > 0 then
            targetTab.CanvasSize = UDim2.new(0, 0, 0, contentHeight + 40)
        end
    end

    RenderHistoryUI()

    SaveBtn.MouseButton1Click:Connect(function()
        SaveBtn.Text = "SAVING..."
        UpdateRealTimePreview()

        local newEntry = {
            Name = currentCustomName,
            Effect = currentEffect,
            Font = currentFont,
            Color1 = cColor1,
            Color2 = cColor2,
            Color3 = cColor3,
            Color4 = cColor4,
            Color5 = cColor5,
            Stroke = currentStroke
        }
        
        if #tagHistory == 0 or (tagHistory[1].Name ~= newEntry.Name or tagHistory[1].Effect ~= newEntry.Effect or tagHistory[1].Font ~= newEntry.Font or tagHistory[1].Color1 ~= newEntry.Color1) then
            table.insert(tagHistory, 1, newEntry)
            if #tagHistory > 10 then table.remove(tagHistory, 11) end
            saveTagHistory()
            RenderHistoryUI()
        end

        task.spawn(function()
            pcall(function()
                local payload = _G.CustomTagsConfig[uidStr]
                _G.SupabaseReq("/tags?on_conflict=id", "POST", { id = uidStr, payload = payload })
            end)
        end)

        task.wait(0.5)
        SaveBtn.Text = "SUCCESS!"
        SaveBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        SaveBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
        task.wait(1.5)
        SaveBtn.Text = "SAVE TO CLOUD"
        SaveBtn.BackgroundColor3 = Color3.fromRGB(140, 0, 255)
        SaveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        targetTab.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 40)
    end)
end)
