_G.S7xToggleAntiAdm = function()
    _G.AntiAdmEnabled = not _G.AntiAdmEnabled
    if type(setToggleState) == "function" and GUI.AntiAdmBtn then 
        setToggleState(GUI.AntiAdmBtn, _G.AntiAdmEnabled) 
    end 
    
    if _G.AntiAdmEnabled then
        if type(S7xNotify) == "function" then S7xNotify("ANTI ADMIN", "Network & Game Role scanner active.") end
        if _G.AntiAdmConn then _G.AntiAdmConn:Disconnect() end
        
        -- Escuta novas entradas
        _G.AntiAdmConn = game:GetService("Players").PlayerAdded:Connect(function(newPlayer)
            if _G.AntiAdmEnabled then 
                task.spawn(function()
                    task.wait(2) -- Aguarda carregar dados do jogador (Teams/Leaderstats)
                    local isThreat, reason, roleName = CheckForAdminPermissions(newPlayer)
                    if isThreat then
                        _G.S7xShowAdminWarning(newPlayer.Name, roleName, reason)
                    end
                end)
            end
        end)
        
        -- Scanner Retroativo (Analisa quem JÁ ESTÁ no servidor)
        task.spawn(function()
            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                if p ~= game.Players.LocalPlayer then
                    local isThreat, reason, roleName = CheckForAdminPermissions(p)
                    if isThreat then
                        -- Dispara o alarme imediatamente se um mod já estiver escondido no mapa
                        _G.S7xShowAdminWarning(p.Name, roleName, reason)
                    end
                end
            end
        end)
    else
        if _G.AntiAdmConn then _G.AntiAdmConn:Disconnect(); _G.AntiAdmConn = nil end
        if type(S7xNotify) == "function" then S7xNotify("ANTI ADMIN", "Scanner offline.") end
    end
end

