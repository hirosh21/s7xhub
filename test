-- [ SISTEMA CINEMÁTICO SUPREMO: ENTRADA DO OWNER (1 VEZ POR SERVIDOR) ]
-- ==========================================

_G.PlayOwnerCinematic = function(ownerPlayer)
    if not ownerPlayer then return end
    
    local coreGui = game:GetService("CoreGui")
    local lockName = "S7xCinematicLock_" .. ownerPlayer.UserId
    
    -- [ TRAVA ANTI-REEXECUÇÃO ]: Se o cadeado já existir, não toca de novo!
    if coreGui:FindFirstChild(lockName) then 
        return 
    end
    
    -- Cria o cadeado silencioso na memória do jogo
    local lock = Instance.new("Folder")
    lock.Name = lockName
    lock.Parent = coreGui

    task.spawn(function()
        -- ==========================================
        -- 1. Efeitos Físicos 3D no Corpo do Owner
        -- ==========================================
        task.spawn(function()
            pcall(function()
                local char = ownerPlayer.Character or ownerPlayer.CharacterAdded:Wait()
                local hrp = char:WaitForChild("HumanoidRootPart", 5)
                if hrp then
                    -- Som de Explosão/Aura na posição do Owner
                    local sfx = Instance.new("Sound", hrp)
                    sfx.SoundId = "rbxassetid://821439273"
                    sfx.Volume = 5
                    sfx.MaxDistance = 250
                    sfx.RollOffMode = Enum.RollOffMode.Linear
                    sfx:Play()

                    -- Criação da Aura de Fogo Absoluta
                    local att = Instance.new("Attachment", hrp)
                    local fire = Instance.new("ParticleEmitter", att)
                    fire.Name = "OwnerSupremeFire"
                    fire.Texture = "rbxassetid://1084955012"
                    fire.Color = ColorSequence.new(Color3.fromRGB(255, 50, 0), Color3.fromRGB(255, 180, 0))
                    fire.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 7), NumberSequenceKeypoint.new(1, 0)})
                    fire.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
                    fire.Lifetime = NumberRange.new(0.8, 1.5)
                    fire.Rate = 150
                    fire.Speed = NumberRange.new(10, 25)
                    fire.EmissionDirection = Enum.NormalId.Top
                    fire.LightEmission = 1
                    fire.ZOffset = 2
                    
                    -- Fogo se dissipa após 12 segundos para não poluir
                    task.delay(12, function()
                        if fire then
                            game:GetService("TweenService"):Create(fire, TweenInfo.new(2), {Rate = 0}):Play()
                            task.wait(2)
                            att:Destroy()
                        end
                    end)
                end
            end)
        end)

        -- ==========================================
        -- 2. Interface Cinemática na Tela
        -- ==========================================
        local cineGui = Instance.new("ScreenGui", coreGui)
        cineGui.Name = "S7xOwnerArrival"
        cineGui.IgnoreGuiInset = true
        cineGui.DisplayOrder = 9999999
        
        -- Fundo Escurecendo Suavemente
        local bg = Instance.new("Frame", cineGui)
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bg.BackgroundTransparency = 1
        
        -- Barras de Cinema (Cinematic Letterbox)
        local topBar = Instance.new("Frame", cineGui)
        topBar.Size = UDim2.new(1, 0, 0, 0)
        topBar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        topBar.BorderSizePixel = 0
        
        local botBar = Instance.new("Frame", cineGui)
        botBar.Size = UDim2.new(1, 0, 0, 0)
        botBar.Position = UDim2.new(0, 0, 1, 0)
        botBar.AnchorPoint = Vector2.new(0, 1)
        botBar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        botBar.BorderSizePixel = 0
        
        -- Texto Supremo
        local textLbl = Instance.new("TextLabel", cineGui)
        textLbl.Size = UDim2.new(1, 0, 0, 100)
        textLbl.Position = UDim2.new(0, 0, 0.5, -50)
        textLbl.BackgroundTransparency = 1
        textLbl.Font = Enum.Font.GothamBlack
        textLbl.TextSize = 35
        textLbl.Text = ""
        textLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLbl.TextStrokeTransparency = 0.5
        textLbl.TextStrokeColor3 = Color3.fromRGB(50, 0, 0)
        
        -- Efeito de Fogo animado correndo por dentro do Texto
        local grad = Instance.new("UIGradient", textLbl)
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 120, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 220, 0))
        })
        grad.Rotation = 45
        
        local ts = game:GetService("TweenService")
        ts:Create(bg, TweenInfo.new(2, Enum.EasingStyle.Sine), {BackgroundTransparency = 0.4}):Play()
        ts:Create(topBar, TweenInfo.new(2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 120)}):Play()
        ts:Create(botBar, TweenInfo.new(2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 120)}):Play()
        
        -- Som Global Tensão Suspense
        local tensionSfx = Instance.new("Sound", coreGui)
        tensionSfx.SoundId = "rbxassetid://9069528756" 
        tensionSfx.Volume = 1.5
        tensionSfx:Play()
        game:GetService("Debris"):AddItem(tensionSfx, 15)
        
        task.wait(2)
        
        -- Detecção Inteligente de Idioma
        local lang = game:GetService("LocalizationService").RobloxLocaleId
        local isPortuguese = string.find(string.lower(lang), "pt")
        local msg = isPortuguese and ("O DONO S7X " .. string.upper(ownerPlayer.DisplayName) .. " ESTÁ NO JOGO") 
                                  or ("THE S7X OWNER " .. string.upper(ownerPlayer.DisplayName) .. " HAS ARRIVED")
        
        -- Digitação Extremamente Lenta e Dramática
        for i = 1, #msg do
            textLbl.Text = string.sub(msg, 1, i)
            
            -- Batida de teclado mecânica/cinemática por letra
            pcall(function()
                local tickSfx = Instance.new("Sound", coreGui)
                tickSfx.SoundId = "rbxassetid://421058925" 
                tickSfx.Volume = 0.5
                tickSfx.PlaybackSpeed = 0.7
                tickSfx:Play()
                game:GetService("Debris"):AddItem(tickSfx, 0.5)
            end)
            
            -- Anima o fogo nas letras enquanto digita
            grad.Rotation = (grad.Rotation + 20) % 360
            
            task.wait(0.15) -- Ritmo "bem devagar"
        end
        
        -- Efeito de Impacto Final da Frase (BAM!)
        local boomSfx = Instance.new("Sound", coreGui)
        boomSfx.SoundId = "rbxassetid://2875150931"
        boomSfx.Volume = 4
        boomSfx:Play()
        game:GetService("Debris"):AddItem(boomSfx, 4)
        
        ts:Create(textLbl, TweenInfo.new(0.1, Enum.EasingStyle.Bounce), {TextSize = 42}):Play()
        task.wait(0.1)
        ts:Create(textLbl, TweenInfo.new(0.6, Enum.EasingStyle.Bounce), {TextSize = 35}):Play()
        
        -- Continua animando o fogo do texto por alguns segundos
        local loopGrad = true
        task.spawn(function()
            while loopGrad do
                grad.Rotation = (grad.Rotation + 1) % 360
                game:GetService("RunService").RenderStepped:Wait()
            end
        end)
        
        -- Tempo de exibição da mensagem na tela (6 Segundos)
        task.wait(6)
        loopGrad = false
        
        -- Ocultação Suave e Elegante
        ts:Create(bg, TweenInfo.new(2, Enum.EasingStyle.Sine), {BackgroundTransparency = 1}):Play()
        ts:Create(textLbl, TweenInfo.new(1.5), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
        ts:Create(topBar, TweenInfo.new(2, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {Size = UDim2.new(1, 0, 0, 0)}):Play()
        ts:Create(botBar, TweenInfo.new(2, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {Size = UDim2.new(1, 0, 0, 0)}):Play()
        
        task.wait(2)
        cineGui:Destroy()
    end)
end

