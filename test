                    Duration = 10,
                    Button1 = "OK"
                })
            end

            -- Injeta o Visualizador APENAS UMA VEZ na sessão para evitar crash
            if not autoParryVisualizerLoaded then
                autoParryVisualizerLoaded = true
                pcall(function()
                    loadstring(game:HttpGet("https://scriptblox.com/raw/UPD-Blade-Ball-op-autoparry-with-visualizer-8652"))()
                end)
            end

            -- Conecta o motor PreSimulation (Processamento Antes do Frame = Zero Delay)
            if not autoParryConn then
                autoParryConn = game:GetService("RunService").PreSimulation:Connect(function()
                    if not _G.AutoParryBB then return end
                    
                    local char = game.Players.LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local ball = getBladeBall()
                    
                    if not ball or not hrp then return end
                    
                    -- Blindagem anti-erro na extração de velocidade
                    local speed = 0.001
                    local zoomies = ball:FindFirstChild("zoomies")
                    
                    if zoomies and zoomies:IsA("VectorForce") then
                        speed = zoomies.VectorVelocity.Magnitude
                    else
                        speed = ball.AssemblyLinearVelocity.Magnitude
                    end
                    if speed == 0 then speed = 0.001 end
                    
                    local distance = (hrp.Position - ball.Position).Magnitude
                    
                    -- Mantém sua matemática nativa de 0.55 (Mas respeita o slider do Hub se o usuário mexer)
                    local threshold = _G.ParryDistance and math.clamp(_G.ParryDistance / 100, 0.1, 1.5) or 0.55
                    
                    -- Lógica Suprema de Defesa
                    if ball:GetAttribute("target") == game.Players.LocalPlayer.Name and not isParried and (distance / speed) <= threshold then
                        -- Envia o Click e SOLTA rapidamente (evita bugar a câmera do jogo segurando o click)
                        vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                        task.delay(0.05, function() vim:SendMouseButtonEvent(0, 0, 0, false, game, 0) end)
                        
                        isParried = true
                        parryCooldown = tick()
                    end
                    
                    -- Reset de segurança automático
                    if isParried and (tick() - parryCooldown) >= 1 then
                        isParried = false
                    end
                end)
            end
        else
            -- Limpeza Cirúrgica: Desliga as conexões quando desativado para remover Lag/Stuttering
