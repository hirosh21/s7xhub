            FireNotify("TOMATO SPAM", "Aperte T para atacar tomate, R para parar.")
            if GUI.TomatoWidget then GUI.TomatoWidget.Visible = false end
        end
    else
        -- Desligamento
        stopTomatoTarget()
        if GUI.TomatoWidget then GUI.TomatoWidget.Visible = false end
    end
end)

