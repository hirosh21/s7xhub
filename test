                GUI.ProfileStroke.Color = tagBaseColor
                GUI.AvatarStroke.Color = tagBaseColor
            
                -- Estatísticas de Máquina
                local fps = math.floor(frames / (now - lastUpdate))
                GUI.FpsLabel.Text = "FPS: " .. fps
                
                local ping = math.round(game.Players.LocalPlayer:GetNetworkPing() * 1000)
