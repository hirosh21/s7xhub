_G.S7xSessionStart = _G.S7xSessionStart or tick()
task.spawn(function()
    local RS = game:GetService("RunService")
    local frames, lastUpdate = 0, tick()
    local execNameCache = string.upper(type(GUI.GetExecutorName) == "function" and GUI.GetExecutorName() or "UNKNOWN")
    
    if GUI.ExecTxt then GUI.ExecTxt.Text = execNameCache end

    RS.RenderStepped:Connect(function()
        frames = frames + 1
        local now = tick()
        if now - lastUpdate >= 1 then
            if GUI.MiniMenu and GUI.MiniMenu.Visible then
                -- Calcula FPS
                local fps = math.floor(frames / (now - lastUpdate))
                if GUI.FpsTxt then GUI.FpsTxt.Text = fps .. " fps" end
                
                -- Calcula Ping
                local ping = math.round(game.Players.LocalPlayer:GetNetworkPing() * 1000)
                if GUI.PingTxt then GUI.PingTxt.Text = ping .. " ms" end
                
                -- Atualiza Jogadores no Servidor
                local playerCount = #game.Players:GetPlayers()
                local maxPlayers = game.Players.MaxPlayers
                if GUI.ServerTxt then GUI.ServerTxt.Text = playerCount .. "/" .. maxPlayers end
            end
            frames = 0
            lastUpdate = now
        end
    end)
end)

