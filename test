local function createButton(text, parent)
    local btn = Instance.new("TextButton", parent)
    btn.Text = ""
    btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- PRETO ABSOLUTO
    btn.Size = UDim2.new(0.88, 0, 0, 38)
    btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8) 
   
    local strk = Instance.new("UIStroke", btn)
    strk.Color = Color3.fromRGB(35, 35, 40) -- Borda sutil para dar relevo e não sumir no fundo
    strk.Thickness = 1.2
    strk.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    
    local lbl = Instance.new("TextLabel", btn)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    -- Remove emojis automaticamente
    lbl.Text = string.gsub(text, "[%z\1-\127\194-\244][\128-\191]*", function(c) return #c > 2 and "" or c end)
    lbl.TextColor3 = Color3.fromRGB(180, 180, 190)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    
    btn.MouseEnter:Connect(function()
        if SafeTween then
            SafeTween(btn, 0.3, {BackgroundColor3 = Color3.fromRGB(15, 15, 18)}) -- Leve brilho ao passar o mouse
            SafeTween(strk, 0.3, {Color = Color3.fromRGB(140, 0, 255), Thickness = 1.5})
            SafeTween(lbl, 0.3, {TextColor3 = Color3.fromRGB(255, 255, 255)})
        end
    end)
    btn.MouseLeave:Connect(function()
        if SafeTween then
            SafeTween(btn, 0.3, {BackgroundColor3 = Color3.fromRGB(0, 0, 0)}) -- Retorna ao Preto Absoluto
            SafeTween(strk, 0.3, {Color = Color3.fromRGB(35, 35, 40), Thickness = 1.2})
            SafeTween(lbl, 0.3, {TextColor3 = Color3.fromRGB(180, 180, 190)})
        end
    end)
    return btn
end

