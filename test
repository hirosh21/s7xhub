_G.S7xGameName = "SERVER"

task.spawn(function()
    local mps = game:GetService("MarketplaceService")
    local success, info = false, nil
    
    -- Tenta até 3 vezes buscar o nome correto caso a API do Roblox demore ou o executor falhe
    for i = 1, 3 do
        success, info = pcall(function()
            return mps:GetProductInfo(game.PlaceId)
        end)
        
        if success and type(info) == "table" and info.Name then
            -- Bloqueia erros de executores que retornam o nome do serviço em vez do jogo
            if not string.find(string.lower(info.Name), "marketplace") then
                _G.S7xGameName = info.Name
                break
            end
        end
        task.wait(1.5) -- Delay de segurança entre tentativas
    end
    
    -- Fallback nativo caso o servidor esteja com a API do Roblox fora do ar
    if _G.S7xGameName == "SERVER" and game.Name ~= "Game" then
        _G.S7xGameName = game.Name
    end
    
    -- Aplica na UI (Aba Lateral)
    if serverTabLbl then
        serverTabLbl.Text = "<uppercase>" .. _G.S7xGameName .. "</uppercase>"
    end
end)

