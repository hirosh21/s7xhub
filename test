            if text == "" then 
                UpdateTargetDisplay(nil)
                return 
            end
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    if string.sub(string.lower(player.Name), 1, #text) == text or string.sub(string.lower(player.DisplayName), 1, #text) == text then
                        UpdateTargetDisplay(player)
                        break
                    end
                end
            end
        end)

        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            
            if KeyBindBox.Text ~= "" then
                local success, keyCode = pcall(function() return Enum.KeyCode[KeyBindBox.Text] end)
                if success and input.KeyCode == keyCode then 
                    TriggerAim() 
                end
            end
            
            if input.KeyCode == Enum.KeyCode.Y then
                guiVisible = not guiVisible
                MainFrame.Visible = guiVisible
            end
        end)

        ToolButton.MouseButton1Click:Connect(TriggerAim)

        ToggleButton.MouseButton1Click:Connect(function()
