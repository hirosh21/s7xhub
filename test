    -- Ajuste matemático: 132px de recuo para respeitar a nova largura da aba lateral premium
    frame.Size = UDim2.new(1, -132, 1, -50) 
    frame.Position = UDim2.new(0, 132, 0, 50) 
    frame.BackgroundTransparency = 1
    frame.Visible = isVisible
    
    if isScroll then 
        frame.ScrollBarThickness = 2 -- Barra fina e elegante
        frame.ScrollBarImageColor3 = Color3.fromRGB(170, 0, 255)
        -- O SEGREDO: Corta os botões que tentarem vazar para fora da área de rolagem
        frame.ClipsDescendants = true 
    else
        frame.ClipsDescendants = true
    end
    return frame
end

