        local myHum = char and char:FindFirstChild("Humanoid")
        
        if myHrp and myHum then
            local savedPos = myHrp.CFrame
            local oldPlatformStand = myHum.PlatformStand
            myHum.PlatformStand = true
            
            for _, target in ipairs(Players:GetPlayers()) do
                if target ~= player and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    local tHrp = target.Character.HumanoidRootPart
                    local t = tick()
                    while tick() - t < 0.4 do
                        RunService.Heartbeat:Wait()
                        if myHrp and tHrp then
                            myHrp.CFrame = tHrp.CFrame
                            myHrp.Velocity = Vector3.new(0, -9e8, 0)
                            myHrp.RotVelocity = Vector3.new(0, 0, 0)
                        else
                            break
                        end
                    end
                end
            end
            
            myHum.PlatformStand = oldPlatformStand
            myHrp.Velocity = Vector3.zero
            myHrp.RotVelocity = Vector3.zero
            myHrp.CFrame = savedPos
        end
        
        GUI.VoidAllBtn.Text = "DONE!"
        task.wait(1)
        if GUI.VoidAllBtn then GUI.VoidAllBtn.Text = origText end
        isVoidingAll = false
    end)
end)

