PopulateServers = function()
    if GUI.IsFetchingServers then return end
    GUI.IsFetchingServers = true
    scanLbl.Text = "SCANNING..."
    for _, v in pairs(GUI.ServerListContainer:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    
    task.spawn(function()
        local layoutCount = 1
        local s_friends, friendsList = pcall(function() return game.Players.LocalPlayer:GetFriendsOnline(200) end)
        if s_friends and friendsList then
            for _, friend in ipairs(friendsList) do
                if friend.PlaceId == game.PlaceId and friend.GameId ~= game.JobId and friend.GameId ~= "" then
                    GUI.RenderServerCard({isFriend = true, friendId = friend.VisitorId, friendName = friend.UserName, friendDisplay = friend.DisplayName, friendUser = friend.UserName, jobId = friend.GameId, locStr = friend.LastLocation or "Active Server"}, layoutCount)
                    layoutCount = layoutCount + 1
                end
            end
        end
        
        local s_public, result = pcall(function() return game:HttpGet("https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100") end)
        if s_public and result then
            local decoded = game:GetService("HttpService"):JSONDecode(result)
            if decoded and decoded.data then
                for _, server in ipairs(decoded.data) do
                    if server.id ~= game.JobId and server.playing < server.maxPlayers then
                        GUI.RenderServerCard({isFriend = false, jobId = server.id, ping = server.ping, playing = server.playing, maxPlayers = server.maxPlayers}, layoutCount)
                        layoutCount = layoutCount + 1
                    end
                end
            end
        end
        scanLbl.Text = "SCAN SERVERS & FRIENDS"
        GUI.IsFetchingServers = false
    end)
end

GUI.RefreshServersBtn.MouseButton1Click:Connect(PopulateServers)

