-- Função que cria a animação do Toast
local function S7xNotify(title, text)
    -- [ LÓGICA ANTI-SPAM ]
    -- 1. Previne a mesma notificação exata em menos de 1 segundo
    if _G.LastNotifyMsg == text and (tick() - _G.LastNotifyTime) < 1 then return end
    _G.LastNotifyMsg = text
    _G.LastNotifyTime = tick()

    -- 2. Limita a quantidade máxima na tela (Max: 3)
    local currentNotifs = {}
    for _, v in ipairs(GUI.NotifyContainer:GetChildren()) do
        if v:IsA("Frame") then table.insert(currentNotifs, v) end
    end
    if #currentNotifs >= 3 then
        currentNotifs[1]:Destroy() -- Destrói a notificação mais antiga instantaneamente
    end

    -- [ CONSTRUÇÃO VISUAL ]
    local notif = Instance.new("Frame", GUI.NotifyContainer)
    notif.Size = UDim2.new(1, 0, 0, 45)
    notif.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Fundo Preto Absoluto
    notif.BackgroundTransparency = 1
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 4)
    
    local strk = Instance.new("UIStroke", notif)
    strk.Color = Color3.fromRGB(255, 255, 255) -- Borda Branca
    strk.Thickness = 1
    strk.Transparency = 1
    
    local titleLbl = Instance.new("TextLabel", notif)
    titleLbl.Size = UDim2.new(1, -15, 0, 20)
    titleLbl.Position = UDim2.new(0, 10, 0, 5)
    titleLbl.BackgroundTransparency = 1
    -- Opcional: Remove possíveis emojis enviados de outras áreas usando GSub básico
    titleLbl.Text = string.gsub(title, "[%z\1-\127\194-\244][\128-\191]*", function(c) return #c > 2 and "" or c end)
    titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255) -- Título Branco
    titleLbl.Font = Enum.Font.GothamBlack
    titleLbl.TextSize = 11
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.TextTransparency = 1
    
    local descLbl = Instance.new("TextLabel", notif)
    descLbl.Size = UDim2.new(1, -15, 0, 20)
    descLbl.Position = UDim2.new(0, 10, 0, 20)
    descLbl.BackgroundTransparency = 1
    descLbl.Text = text
    descLbl.TextColor3 = Color3.fromRGB(180, 180, 180) -- Texto Cinza Claro
    descLbl.Font = Enum.Font.GothamMedium
    descLbl.TextSize = 11
    descLbl.TextXAlignment = Enum.TextXAlignment.Left
    descLbl.TextTransparency = 1
    
    -- [ ANIMAÇÕES DE ENTRADA ]
    pcall(function()
        local ts = game:GetService("TweenService")
        ts:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {BackgroundTransparency = 0.2}):Play()
        ts:Create(strk, TweenInfo.new(0.3), {Transparency = 0.6}):Play()
        ts:Create(titleLbl, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
        ts:Create(descLbl, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    end)
    
    -- [ ANIMAÇÃO DE SAÍDA E DESTRUIÇÃO (Auto-limpeza) ]
    task.delay(2.5, function()
        if notif and notif.Parent then
            pcall(function()
                local ts = game:GetService("TweenService")
                ts:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {BackgroundTransparency = 1}):Play()
                ts:Create(strk, TweenInfo.new(0.3), {Transparency = 1}):Play()
                ts:Create(titleLbl, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
                ts:Create(descLbl, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
            end)
            task.wait(0.35)
            if notif then notif:Destroy() end
        end
    end)
end

