antiAfkEnabled = false 
afkConn = nil

local function ToggleAntiAfk(state)
    antiAfkEnabled = state
    -- Atualiza a UI (Alavanca)
    if type(setToggleState) == "function" then setToggleState(GUI.AntiAfkBtn, antiAfkEnabled) end
    
    if antiAfkEnabled then
        -- [ CAMADA 1 ]: Bloqueio Silencioso (Zero Simulação, Zero Bugs)
        -- Desativa o gatilho de inatividade do próprio Roblox direto na memória
        pcall(function()
            if getconnections then
                for _, conn in pairs(getconnections(game.Players.LocalPlayer.Idled)) do
                    conn:Disable()
                end
            end
        end)

        -- [ CAMADA 2 ]: Fallback Seguro (Caso o executor não suporte a Camada 1)
        if not afkConn then
            afkConn = game.Players.LocalPlayer.Idled:Connect(function() 
                task.spawn(function()
                    pcall(function()
                        local vu = game:GetService("VirtualUser")
                        -- Dá um leve toque virtual no botão direito sem roubar a câmera ou o mouse
                        vu:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                        task.wait(0.1)
                        vu:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                    end)
                end)
            end)
        end
    else
        -- Restaura as conexões de inatividade nativas do jogo
        pcall(function()
            if getconnections then
                for _, conn in pairs(getconnections(game.Players.LocalPlayer.Idled)) do
                    conn:Enable()
                end
            end
        end)
        
        -- Limpeza cirúrgica da memória
        if afkConn then 
            afkConn:Disconnect()
            afkConn = nil 
        end
    end
end

