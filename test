-- Motor do Tomate
local function getTomatoRemote()
    local char = game.Players.LocalPlayer.Character
    local tool = char and char:FindFirstChild("Tomato") or game.Players.LocalPlayer.Backpack:FindFirstChild("Tomato")
    return tool and tool:FindFirstChild("RemoteEvent")
end

local function lockTomatoTarget()
    local mouse = game.Players.LocalPlayer:GetMouse()
    local target = mouse.Target
    local model = target and target:FindFirstAncestorOfClass("Model")
    
    if model and model:FindFirstChild("Humanoid") then
        tomatoTarget = model
        isTomatoSpamming = true
        if type(S7xNotify) == "function" then S7xNotify("TOMATO LOCK", "Atacando: " .. tomatoTarget.Name) end
        if SafeTween then 
            SafeTween(GUI.TomLockBtn, 0.3, {BackgroundColor3 = Color3.fromRGB(255, 50, 50), TextColor3 = Color3.fromRGB(255, 255, 255)})
            SafeTween(GUI.TomStopBtn, 0.3, {BackgroundColor3 = Color3.fromRGB(20, 20, 25), TextColor3 = Color3.fromRGB(150, 150, 160)})
        end
    else
        if type(S7xNotify) == "function" then S7xNotify("ERROR", "Mire em um jogador válido!") end
    end
end

local function stopTomatoTarget()
    tomatoTarget = nil
    isTomatoSpamming = false
    if type(S7xNotify) == "function" then S7xNotify("TOMATO STOP", "Ataque cancelado.") end
    if SafeTween then 
        SafeTween(GUI.TomLockBtn, 0.3, {BackgroundColor3 = Color3.fromRGB(30, 20, 20), TextColor3 = Color3.fromRGB(255, 100, 100)})
        SafeTween(GUI.TomStopBtn, 0.3, {BackgroundColor3 = Color3.fromRGB(255, 50, 50), TextColor3 = Color3.fromRGB(255, 255, 255)})
        task.delay(0.5, function() SafeTween(GUI.TomStopBtn, 0.3, {BackgroundColor3 = Color3.fromRGB(20, 20, 25), TextColor3 = Color3.fromRGB(150, 150, 160)}) end)
    end
end

