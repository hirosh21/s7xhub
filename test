            if customConf then
                -- Extrai as 5 camadas de cor da Customização do Jogador
                local c1 = _G.S7xParseColor(customConf.Color1 or customConf.Color, Color3.fromRGB(255, 255, 255))
                local c2 = _G.S7xParseColor(customConf.Color2, Color3.fromRGB(200, 200, 200))
                local c3 = _G.S7xParseColor(customConf.Color3, Color3.fromRGB(150, 150, 150))
                local c4 = _G.S7xParseColor(customConf.Color4, Color3.fromRGB(100, 100, 100))
                local c5 = _G.S7xParseColor(customConf.Color5, Color3.fromRGB(50, 50, 50))
                
                local cStroke = _G.S7xParseColor(customConf.StrokeColor, Color3.fromRGB(0, 0, 0))
                local transpStroke = tonumber(customConf.StrokeTransparency) or 0
                local effect = customConf.Effect or "Solid"

                lbl.TextStrokeColor3 = cStroke
                lbl.TextStrokeTransparency = transpStroke

                -- O SEGREDO PROFISSIONAL: Cada efeito agora usa as Cores (C1 até C5) mapeadas
                if effect == "Metallic" or effect == "Metalico" then
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, c1),
                        ColorSequenceKeypoint.new(0.40, c1),
                        ColorSequenceKeypoint.new(0.5, c2), -- Brilho Metálico
                        ColorSequenceKeypoint.new(0.60, c1),
                        ColorSequenceKeypoint.new(1, c1)
                    })
                    grad.Offset = Vector2.new(metallicOffset, 0)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)

                elseif effect == "Duo-chrome" then
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, c1),
                        ColorSequenceKeypoint.new(0.5, c2),
                        ColorSequenceKeypoint.new(1, c3)
                    })
                    grad.Offset = Vector2.new(metallicOffset * 0.8, 0)
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)

                elseif effect == "Rainbow" or effect == "Chroma" then
                    -- Usa as 5 cores para formar uma onda Chroma personalizada
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, c1),
                        ColorSequenceKeypoint.new(0.25, c2),
                        ColorSequenceKeypoint.new(0.5, c3),
                        ColorSequenceKeypoint.new(0.75, c4),
                        ColorSequenceKeypoint.new(1, c5)
