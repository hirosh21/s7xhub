local function showPlayerInfo(tPlayer)
    if not tPlayer then return end
    GUI.PlayerInfoPanel.Visible = true
    
    -- [ IDENTIDADE E CONTA ]
    local accAge = tPlayer.AccountAge
    local creationDate = os.date("%d/%m/%Y", os.time() - (accAge * 86400))
    local premium = (tPlayer.MembershipType == Enum.MembershipType.Premium) and "<font color='#ffaa00'>Premium</font>" or "Standard"
    
    -- [ TEMPO E SESSÃO ]
    local joinTime = playerJoinTimes[tPlayer.UserId] or os.time()
    local playTime = os.time() - joinTime
    local hours = math_floor(playTime / 3600)
    local mins = math_floor((playTime % 3600) / 60)
    local secs = playTime % 60
    local joinDate = os.date("%H:%M:%S", joinTime)
    
    -- [ SOCIAL E REDE ]
    local friendsCount = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= tPlayer then
            local s, isFriend = pcall(function() return tPlayer:IsFriendsWith(p.UserId) end)
            if s and isFriend then friendsCount = friendsCount + 1 end
        end
    end
    
    local isMyFriend = false
    pcall(function() isMyFriend = player:IsFriendsWith(tPlayer.UserId) end)
    local myFriendText = isMyFriend and "<font color='#00ff00'>Yes</font>" or "<font color='#ff0000'>No</font>"
    
    local ping = "N/A"
    pcall(function() ping = math_round(tPlayer:GetNetworkPing() * 1000) .. " ms" end)
    
    -- [ FÍSICA E PERSONAGEM ]
    local char = tPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    local health = hum and math_floor(hum.Health) or 0
    local maxHealth = hum and math_floor(hum.MaxHealth) or 100
    local walkSpeed = hum and math_floor(hum.WalkSpeed) or 0
    local jumpPower = hum and (hum.UseJumpPower and math_floor(hum.JumpPower) or math_floor(hum.JumpHeight)) or 0
    
    local coords = hrp and string.format("X: %.1f, Y: %.1f, Z: %.1f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z) or "Unknown Data"
    local velocity = hrp and math_floor(hrp.Velocity.Magnitude) .. " studs/s" or "0 studs/s"
    
    local state = "Unknown"
    if hum then
        local stateType = hum:GetState()
        if stateType == Enum.HumanoidStateType.Freefall then state = "<font color='#ff5555'>Falling/Airborne</font>"
        elseif stateType == Enum.HumanoidStateType.Seated then state = "<font color='#55aaff'>Sitting</font>"
        elseif hum.MoveDirection.Magnitude > 0 then state = "<font color='#55ff55'>Moving</font>"
        else state = "Idle" end
    end
    
    local distance = "N/A"
    local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if myHrp and hrp then
        distance = math_floor((myHrp.Position - hrp.Position).Magnitude) .. " studs"
    end
    
    -- [ INVENTÁRIO (SNOOPING) ]
    local equipped = "None"
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then equipped = tool.Name end
    
    local backpackCount = 0
    local bp = tPlayer:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") then backpackCount = backpackCount + 1 end
        end
    end
    
    -- [ ANÁLISE DE AMEAÇA ]
    local threatLevel = "<font color='#00ff00'>LOW (Legit)</font>"
    if walkSpeed > 30 or (hrp and hrp.Velocity.Magnitude > 150) then
        threatLevel = "<font color='#ff0000'>HIGH (Anomalous Movement)</font>"
    end
    
    -- [ MONTAGEM DO PAINEL ]
    GUI.PIPContent.Text = string.format(
        "<font color='#aa00ff'><b>[ 👤 IDENTITY & STATUS ]</b></font>\n" ..
        "<b>User:</b> %s (@%s)\n" ..
        "<b>ID:</b> %d | <b>Plan:</b> %s\n" ..
        "<b>Created:</b> %s (%d Days)\n\n" ..
        "<font color='#aa00ff'><b>[ 📡 NETWORK & SOCIAL ]</b></font>\n" ..
        "<b>Ping:</b> %s | <b>Session:</b> %02dh %02dm %02ds\n" ..
        "<b>Mutual Friends Here:</b> %d | <b>Befriended You:</b> %s\n\n" ..
        "<font color='#aa00ff'><b>[ 🎯 TRACKING & PHYSICS ]</b></font>\n" ..
        "<b>Coords:</b> %s\n" ..
        "<b>Distance:</b> %s\n" ..
        "<b>State:</b> %s | <b>Velocity:</b> %s\n\n" ..
        "<font color='#aa00ff'><b>[ ⚔️ COMBAT & THREAT ]</b></font>\n" ..
        "<b>HP:</b> %d/%d | <b>SPD:</b> %d | <b>JMP:</b> %d\n" ..
        "<b>Equipped:</b> %s\n" ..
        "<b>Hidden Tools in Backpack:</b> %d\n" ..
        "<b>Threat Level:</b> %s",
        tPlayer.DisplayName, tPlayer.Name, tPlayer.UserId, premium, creationDate, accAge,
