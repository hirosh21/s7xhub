            ToggleButton.BackgroundColor3 = isAttacking and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(140, 0, 255)
        end)

        local function FlingPart(part, targetPos)
            if part and part:IsA("BasePart") then
                pcall(function() part:SetNetworkOwner(LocalPlayer) end)
                part.CanCollide = false
                part.CFrame = CFrame.new(targetPos)
                part.AssemblyLinearVelocity = Vector3.new(0, 1000, 0)
                part.AssemblyAngularVelocity = Vector3.new(CurrentForce, CurrentForce, CurrentForce)
            end
        end

        RunService.Heartbeat:Connect(function()
            if isAttacking and targetPlayer and targetPlayer.Character then
                local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    for _, obj in ipairs(Workspace:GetChildren()) do
                        if obj.Name == TargetObjectName then
                            local handle = obj:FindFirstChild("Handle")
                            if handle then
                                FlingPart(handle, root.Position)
                            end
                        end
                    end
                end
            end
        end) 
    end) 
end)

