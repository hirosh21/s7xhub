        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if hrp then woaBaseY = hrp.Position.Y - 3.2 end
        
        woaPart.Parent = workspace
        if woaLoop then woaLoop:Disconnect() end
        
        woaLoop = game:GetService("RunService").Stepped:Connect(function(_, dt)
            local c = game.Players.LocalPlayer.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            local hum = c and c:FindFirstChild("Humanoid")
            
            if h and hum and hum.Health > 0 then
                local moveSpeed = 35 * dt 
                
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) or _G.WOA_Up then
                    woaBaseY = woaBaseY + moveSpeed
                    h.CFrame = h.CFrame * CFrame.new(0, moveSpeed, 0)
                    h.Velocity = Vector3.new(h.Velocity.X, 0, h.Velocity.Z)
                elseif game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftControl) or _G.WOA_Down then
                    woaBaseY = woaBaseY - moveSpeed
                end
                
                woaPart.CFrame = CFrame.new(h.Position.X, woaBaseY, h.Position.Z)
                
                if h.Velocity.Y < -5 then
                    h.Velocity = Vector3.new(h.Velocity.X, 0, h.Velocity.Z)
                end
            end
        end)
        
        if type(S7xNotify) == "function" then S7xNotify("WALK ON AIR", "Gravidade burlada. Plataforma travada.") end
    else
        if GUI.WOAWidget then GUI.WOAWidget.Visible = false end
        if woaLoop then woaLoop:Disconnect(); woaLoop = nil end
        woaPart.Parent = nil
        if type(S7xNotify) == "function" then S7xNotify("WALK ON AIR", "Gravidade restaurada.") end
    end
end

