                else
                    myHrp.CFrame = tPart.CFrame * offsetCFrame
                    myHrp.Velocity = Vector3.zero
                    myHrp.RotVelocity = Vector3.zero
                end
            end
        end

        table.insert(targetAttachConns, RunService.RenderStepped:Connect(attachLogic))
