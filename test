ApplyS7xAura = function(targetPlayer)
    task.spawn(function()
        pcall(function()
            if not targetPlayer or not targetPlayer.Character then return end
            
            local char_aura = targetPlayer.Character
            local hrp_aura = char_aura:FindFirstChild("HumanoidRootPart")
            if not hrp_aura then return end

            local aura_to_apply = "None"
            if targetPlayer == game.Players.LocalPlayer then
                -- [ WIPE DETECTOR ] Se o banco apagou sua aura customizada, a memória local solta ela na hora!
                if _G.EquippedAura == "Custom" and not (_G.CustomAurasConfig and _G.CustomAurasConfig[tostring(targetPlayer.UserId)]) then
                    _G.EquippedAura = "None"
                end
                aura_to_apply = _G.EquippedAura or "None"
            else
                if _G.PresenceAuras and _G.PresenceAuras[targetPlayer.UserId] then
                    aura_to_apply = _G.PresenceAuras[targetPlayer.UserId]
                end
            end

            for _, v in ipairs(hrp_aura:GetChildren()) do
                if v.Name == "S7x_3DAura" then v:Destroy() end
            end

            local cfg_aura = nil
            if aura_to_apply == "Custom" then
                local cData = _G.CustomAurasConfig[tostring(targetPlayer.UserId)]
                if cData then
                    local tex = cData.Texture or "rbxassetid://1084991215"
                    local rate = tonumber(cData.Rate) or 15
                    local colHex = cData.Color or "#00ffea"
                    local c3 = _G.S7xParseColor(colHex, Color3.fromRGB(0, 255, 234))
                    cfg_aura = {
                        tex = tex, col = ColorSequence.new(c3), rate = rate,
                        size = NumberSequence.new({NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 0)}),
                        rot = NumberRange.new(-180, 180), light = 1
                    }
                end
            elseif aura_to_apply ~= "None" and _G.AuraEmitters and _G.AuraEmitters[aura_to_apply] then
                cfg_aura = _G.AuraEmitters[aura_to_apply]
            end

            if cfg_aura then
                local att_aura = Instance.new("Attachment")
                att_aura.Name = "S7x_3DAura"
                att_aura.Parent = hrp_aura
                
                local pe_aura = Instance.new("ParticleEmitter")
                pe_aura.Texture = cfg_aura.tex
                pe_aura.Color = cfg_aura.col
                pe_aura.Rate = cfg_aura.rate
                pe_aura.Size = cfg_aura.size
                pe_aura.Speed = NumberRange.new(0.01)
                pe_aura.Rotation = cfg_aura.rot
                pe_aura.Lifetime = NumberRange.new(1, 1.5)
                pe_aura.LightEmission = cfg_aura.light
                pcall(function() pe_aura.Brightness = 4 end)
                pe_aura.LockedToPart = true
                pe_aura.ZOffset = 1
                pe_aura.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(0.1, 0),
                    NumberSequenceKeypoint.new(0.9, 0),
                    NumberSequenceKeypoint.new(1, 1)
                })
                pe_aura.Parent = att_aura
            end

            local marker_tgt = char_aura:FindFirstChild("S7xAuraMarker")
            if not marker_tgt then
                marker_tgt = Instance.new("StringValue")
                marker_tgt.Name = "S7xAuraMarker"
                marker_tgt.Parent = char_aura
            end
            marker_tgt.Value = aura_to_apply

            local hum_tgt = char_aura:FindFirstChild("Humanoid")
            if hum_tgt and type(S7xUpdateMoveVFX) == "function" then
                pcall(function() S7xUpdateMoveVFX(char_aura, hum_tgt.MoveDirection.Magnitude > 0 and hum_tgt.WalkSpeed or 0) end)
            end
        end)
    end)
end


