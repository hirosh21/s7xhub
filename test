    local function startTargetAction(actionName, btn, animId, targetPartName, offsetCFrame, customLogic)
        if currentTargetState == actionName then clearTargetState() return end
        if not spectatingPlayer then 
            if type(S7xNotify) == "function" then S7xNotify("ERROR", "Selecione um alvo primeiro!") end
            return 
        end 
        
        clearTargetState()
        currentTargetState = actionName
        applyToggleVisual(btn, true)

        local myChar = game.Players.LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChild("Humanoid")
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

        if not myChar or not myHum or not myHrp then return end

        local finalAnimId = animId
        -- [ ADICIONADO ]: Se for RevShoulders, ele vai puxar a animação de sentar (igual Shoulders normal)
        if actionName == "Headsit" or actionName == "Shoulders" or actionName == "RevShoulders" or actionName == "Backpack" or actionName == "FrontSit" then
            finalAnimId = (myHum.RigType == Enum.HumanoidRigType.R15) and 2506281703 or 178130996
        end

        if finalAnimId then PlayTargetAnim(finalAnimId) end

        myHum.PlatformStand = true
        workspace.FallenPartsDestroyHeight = -9999999 
        for _, v in ipairs(myChar:GetChildren()) do
            if v:IsA("BasePart") then 
                v.CanCollide = false 
                v.Massless = true 
                v.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0)
            end
        end

        local function attachLogic()
            if not spectatingPlayer or not spectatingPlayer.Character or not spectatingPlayer.Character:FindFirstChild("HumanoidRootPart") then
                clearTargetState()
                if type(S7xNotify) == "function" then S7xNotify("TARGET LOST", "O alvo desconectou ou morreu.") end
                return
            end

            local tChar = spectatingPlayer.Character
            local tPart = tChar:FindFirstChild(targetPartName) or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart")
            local tHrp = tChar:FindFirstChild("HumanoidRootPart")
            
            if myHrp and tPart and tHrp then 
                if customLogic then
                    customLogic(myHrp, tHrp)
                else
                    myHrp.CFrame = tPart.CFrame * offsetCFrame
                    myHrp.Velocity = Vector3.zero
                    myHrp.RotVelocity = Vector3.zero
                end
            end
        end

        table.insert(targetAttachConns, RunService.RenderStepped:Connect(attachLogic))
        table.insert(targetAttachConns, RunService.Stepped:Connect(attachLogic))
        table.insert(targetAttachConns, RunService.Heartbeat:Connect(attachLogic))
    end

