local function switchServerTab(showExploits)
    local ts = game:GetService("TweenService")
    local tInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint)

    if showExploits then
        ExploitsContainer.Visible = true
        ServersContentContainer.Visible = false
        ts:Create(ExploitsNavBtn, tInfo, {BackgroundColor3 = Color3.fromRGB(30, 20, 45), TextColor3 = Color3.fromRGB(170, 0, 255)}):Play()
        ts:Create(ServersNavBtn, tInfo, {BackgroundColor3 = Color3.fromRGB(15, 15, 18), TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
        if not ExploitsNavBtn:FindFirstChildOfClass("UIStroke") then Instance.new("UIStroke", ExploitsNavBtn).Color = Color3.fromRGB(170, 0, 255) end
        if ServersNavBtn:FindFirstChildOfClass("UIStroke") then ServersNavBtn:FindFirstChildOfClass("UIStroke"):Destroy() end
    else
        ExploitsContainer.Visible = false
        ServersContentContainer.Visible = true
        ts:Create(ServersNavBtn, tInfo, {BackgroundColor3 = Color3.fromRGB(30, 20, 45), TextColor3 = Color3.fromRGB(170, 0, 255)}):Play()
        ts:Create(ExploitsNavBtn, tInfo, {BackgroundColor3 = Color3.fromRGB(15, 15, 18), TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
        if not ServersNavBtn:FindFirstChildOfClass("UIStroke") then Instance.new("UIStroke", ServersNavBtn).Color = Color3.fromRGB(170, 0, 255) end
        if ExploitsNavBtn:FindFirstChildOfClass("UIStroke") then ExploitsNavBtn:FindFirstChildOfClass("UIStroke"):Destroy() end
    end
end

