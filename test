    local function RenderPage(page)
        CurrentPage = math.clamp(page, 1, TotalPages)
        PageLabel.Text = "PAGE " .. CurrentPage .. " / " .. TotalPages

        for _, v in ipairs(GridScroll:GetChildren()) do
            if v:IsA("TextButton") then v:Destroy() end
        end

        local startIndex = ((CurrentPage - 1) * ItemsPerPage) + 1
        local endIndex = math.min(startIndex + ItemsPerPage - 1, #FilteredDB)

        for i = startIndex, endIndex do
            if FilteredDB[i] then CreateCard(FilteredDB[i]) end
        end
        GridScroll.CanvasPosition = Vector2.new(0, 0)
    end

    local function FilterAndRender(query)
        if not dbLoaded then return end
        FilteredDB = {}
        
        local targetDB = MasterEmotesDB
        if CurrentViewMode == "Packages" then targetDB = MasterPackagesDB
        elseif CurrentViewMode == "Favorites" then targetDB = FavoritesDB end

        for _, data in ipairs(targetDB) do
            if not query or query == "" or string.find(string.lower(data.name), string.lower(query)) then
                table.insert(FilteredDB, data)
            end
        end

        TotalPages = math.max(1, math.ceil(#FilteredDB / ItemsPerPage))
        PaginationFrame.Visible = true

        -- Atualiza o texto do rodapé com a quantidade exata
        local tipoStr = (CurrentViewMode == "Packages") and "pacotes" or "animações"
        StatusText.Text = #FilteredDB .. " " .. tipoStr .. " disponíveis"

        RenderPage(1)
    end

