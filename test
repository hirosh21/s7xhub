    local RS = game:GetService("RunService")
    local player = game.Players.LocalPlayer
    
-- PHANTOM CLIP (NOCLIP ABSOLUTO PARA ITENS + ZERO MASSA + ANTI-FLING)
    _G.PhantomClipEnabled = false
    local phantomClipConn = nil
    
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    GUI.PhantomClipBtn.MouseButton1Click:Connect(function()
        _G.PhantomClipEnabled = not _G.PhantomClipEnabled
        if type(setToggleState) == "function" then setToggleState(GUI.PhantomClipBtn, _G.PhantomClipEnabled) end

        if _G.PhantomClipEnabled then
            if phantomClipConn then phantomClipConn:Disconnect() end
            
            phantomClipConn = RS.Stepped:Connect(function()
                local myChar = player.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myHrp then return end

                local myPos = myHrp.Position

                -- [ 1. NEUTRALIZAÇÃO TOTAL DE TOOLS E ACESSÓRIOS NOS JOGADORES ]
                for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                    if p ~= player and p.Character then
                        local char = p.Character
                        local tHrp = char:FindFirstChild("HumanoidRootPart")
                        
                        -- Otimização: Apenas processa jogadores a menos de 60 studs (Zero Lag)
                        if tHrp and (tHrp.Position - myPos).Magnitude < 60 then
                            for _, child in ipairs(char:GetChildren()) do
                                if child:IsA("Tool") or child:IsA("Accessory") then
                                    for _, part in ipairs(child:GetDescendants()) do
                                        if part:IsA("BasePart") then
                                            -- Remove 100% da física, massa, peso e colisão
                                            part.CanCollide = false
                                            part.Massless = true
                                            part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                                            
                                            -- Se a Tool tentar ser usada para Fling (giro/velocidade anômala)
                                            if part.Velocity.Magnitude > 50 or part.RotVelocity.Magnitude > 30 then
                                                part.Velocity = Vector3.zero
                                                part.RotVelocity = Vector3.zero
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                -- [ 2. ESCUDO DE PROXIMIDADE (ITENS SOLTOS NO CHÃO, DADOS E OBJETOS ARREMESSADOS) ]
                params.FilterDescendantsInstances = {myChar}
                -- Raio de 12 studs: Cobre exatamente seu espaço vital bloqueando arremessos
                local nearbyParts = workspace:GetPartBoundsInRadius(myPos, 12, params)
                
                for i = 1, #nearbyParts do
                    local part = nearbyParts[i]
                    if not part.Anchored then
                        local isItem = part:FindFirstAncestorWhichIsA("Tool") or part:FindFirstAncestorWhichIsA("Accessory")
                        local isFlinging = part.Velocity.Magnitude > 50 or part.RotVelocity.Magnitude > 30
                        
                        -- Se for um item no chão (como o dado) ou uma peça voando na sua direção
                        if isItem or isFlinging then
                            part.CanCollide = false
                            part.Massless = true
                            -- Zera a densidade e atrito (Impede o Roblox de calcular impacto)
                            part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                            
                            if isFlinging then
                                part.Velocity = Vector3.zero
                                part.RotVelocity = Vector3.zero
                                part.AssemblyLinearVelocity = Vector3.zero
                                part.AssemblyAngularVelocity = Vector3.zero
                            end
                        end
                    end
                end
            end)
            
            if type(S7xNotify) == "function" then S7xNotify("NOCLIP ITEM", "Física e Massa de Itens 100% Anulada.") end
        else
            if phantomClipConn then phantomClipConn:Disconnect(); phantomClipConn = nil end
            if type(S7xNotify) == "function" then S7xNotify("NOCLIP ITEM", "Colisão padrão restaurada.") end
        end
    end)

    -- ANTI-STUN SUPREME (QUEBRA-ATORDOAMENTO FÍSICO E DE VARIÁVEIS)
    _G.AntiStunEnabled = false
    local antiStunConn = nil

    GUI.AntiStunBtn.MouseButton1Click:Connect(function()
        _G.AntiStunEnabled = not _G.AntiStunEnabled
        if type(setToggleState) == "function" then setToggleState(GUI.AntiStunBtn, _G.AntiStunEnabled) end

        if _G.AntiStunEnabled then
            if antiStunConn then antiStunConn:Disconnect() end
            
            -- Usamos Stepped para atropelar a engine do Roblox ANTES da simulação física
            antiStunConn = RS.Stepped:Connect(function()
                local char = player.Character
                if char then
                    local hum = char:FindFirstChild("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")

                    if hum then
                        -- 1. Previne lentidão extrema ou paralisia (Força o mínimo de 16 de velocidade)
                        if hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end
                        
                        -- 2. Restaura capacidade de pular (Trata ambos os sistemas antigos e novos do Roblox)
                        if hum.UseJumpPower and hum.JumpPower < 50 then hum.JumpPower = 50 end
                        if not hum.UseJumpPower and hum.JumpHeight < 7.2 then hum.JumpHeight = 7.2 end
                        
                        -- 3. Quebra estados de Stun induzidos por animação ou scripts de combate
                        if hum.PlatformStand then hum.PlatformStand = false end
                        if hum.Sit then hum.Sit = false end
                        
                        -- 4. Força o personagem a levantar se o jogo tentar travá-lo no chão
                        local state = hum:GetState()
                        if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.Seated or state == Enum.HumanoidStateType.Ragdoll then
                            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                        end
                    end

                    -- 5. Solta o jogador se o dev do mapa usar Anchored para prender
                    if hrp and hrp.Anchored then
                        -- Não desancora se o jogador ativou ferramentas do Hub que precisam do anchor (Ex: FakeLag, Freecam)
                        if not _G.FakeLagEnabled and not _G.S7xFreecamEnabled then
                            hrp.Anchored = false
                        end
                    end
                end
            end)
            if type(S7xNotify) == "function" then S7xNotify("ANTI STUN", "Combat restrictions bypassed.") end
        else
            if antiStunConn then antiStunConn:Disconnect(); antiStunConn = nil end
            if type(S7xNotify) == "function" then S7xNotify("ANTI STUN", "System disabled.") end
        end
    end)

