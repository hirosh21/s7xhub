    local isMobile = uis.TouchEnabled and not uis.KeyboardEnabled

    local hoverCount = 0

    local function updateCursor()
        pcall(function()
            if hoverCount > 0 then mouse.Icon = "rbxassetid://13210385552" else mouse.Icon = "" end
        end)
    end

    local function bindCursorEffect(element)
        if isMobile then return end
        if element:IsA("Frame") or element:IsA("GuiButton") or element:IsA("ScrollingFrame") or element:IsA("TextBox") then
            element.MouseEnter:Connect(function() hoverCount = hoverCount + 1; updateCursor() end)
            element.MouseLeave:Connect(function() hoverCount = math.max(0, hoverCount - 1); updateCursor() end)
        end
    end

    local coreGui = game:GetService("CoreGui")
    local audioFolder = coreGui:FindFirstChild("S7x_AudioEngine") or Instance.new("Folder", coreGui)
    audioFolder.Name = "S7x_AudioEngine"

    local function createSFX(id, vol)
        local sfx = Instance.new("Sound", audioFolder)
        sfx.SoundId = "rbxassetid://" .. id
        sfx.Volume = vol
        return sfx
    end

    local hoverSFX = createSFX("6895079853", 0.2) 
    local clickSFX = createSFX("6895050519", 0.6) 
    local tabSFX = createSFX("6895082404", 0.8)   

    local function bindButtonEffects(btn)
        if not btn:IsA("GuiButton") then return end

        if not isMobile then
            btn.MouseEnter:Connect(function() pcall(function() hoverSFX:Play() end) end)
        end

        local uiScale = btn:FindFirstChild("S7x_ClickScale")
        if not uiScale then
            uiScale = Instance.new("UIScale")
            uiScale.Name = "S7x_ClickScale"
            uiScale.Parent = btn
        end

        local ts = game:GetService("TweenService")
        local tDown = TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        local tUp = TweenInfo.new(0.3, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out)

        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                pcall(function() ts:Create(uiScale, tDown, {Scale = 0.92}):Play() end)
            end
        end)

        btn.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                pcall(function() ts:Create(uiScale, tUp, {Scale = 1}):Play() end)
            end
        end)

        btn.MouseLeave:Connect(function()
            pcall(function() ts:Create(uiScale, tUp, {Scale = 1}):Play() end)
        end)

        btn.MouseButton1Click:Connect(function()
            pcall(function()
                local isTabButton = btn.Parent and (btn.Parent.Name == "TabMenu" or btn.Parent.Name == "ScrollingFrame" and btn.Parent.Parent == GUI.MainFrame)
                if isTabButton then tabSFX:Play() else clickSFX:Play() end
            end)
        end)
    end

    if GUI and GUI.ScreenGui then
        for _, element in ipairs(GUI.ScreenGui:GetDescendants()) do
            bindCursorEffect(element)
            bindButtonEffects(element)
        end

        GUI.ScreenGui.DescendantAdded:Connect(function(element)
            bindCursorEffect(element)
            bindButtonEffects(element)
        end)
    end
end)

