    local kbStrk = Instance.new("UIStroke", keyBox)
    kbStrk.Color = Color3.fromRGB(80, 40, 120)
    kbStrk.Thickness = 1
    
    -- O SEGREDO DO ESPAÇAMENTO: Distância exata da alavanca
    if btn:FindFirstChild("ToggleBG") ~= nil then 
        keyBox.Position = UDim2.new(1, -74, 0.5, -10) -- Recuado para não esbarrar na alavanca
    else 
        keyBox.Position = UDim2.new(1, -28, 0.5, -10) 
    end

    keyBox.FocusLost:Connect(function()
        local inputChar = string_upper(string_sub(keyBox.Text, 1, 1))
        local success, code = pcall(function() return Enum.KeyCode[inputChar] end)
        if success and code and inputChar ~= "" then 
            bindKeys[action] = code 
            keyBox.Text = inputChar 
        else 
            bindKeys[action] = nil
            keyBox.Text = "" 
        end
    end)
end

